// !! ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

// Delegated access to one customer AWS account. Access goes through a
// customer-managed IAM role whose trust policy lets the host default account
// assume it with this binding's external ID; no long-lived access key is
// stored. A row can briefly exist with a null roleArn during bootstrap, once
// the external ID is generated but the role ARN is not yet saved.
//
// accountId is both the customer account ID and the binding's scope key: the
// IAM role, its trust policy, the region list and the rotation Lambda are all
// account-level resources. Consumers reference a row through
// AwsCrossAccountBindingUsage.
//
// Rebinding is two-phase: while one is in progress, pendingExternalId holds
// the candidate's external ID and the active identity keeps serving. The
// pending value is promoted, retiring the old external ID, only after the
// candidate role has been assumed successfully.
//
// name is a UI label for the account: never derived from AWS and irrelevant to
// credential resolution.
model AwsCrossAccountBinding {
  id                String                       @id @default(uuid()) @db.Uuid
  accountId         String                       @unique
  name              String?
  roleArn           String?                      @unique
  externalId        String                       @unique
  pendingExternalId String?
  roleName          String?
  rotationLambdaArn String?
  defaultRegion     String?
  regions           String[]
  lastVerifiedAt    DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  usages            AwsCrossAccountBindingUsage[]

  @@schema("module/aws-identity")
}

// Binds one consumer (project / tenant / organization) to one account binding.
// consumerId is deliberately a plain column with no foreign key or Prisma
// relation: the module never reads host tables and stays copy-assemblable into
// any host. A missing row means the consumer has not attached an AWS account.
// The relation to the binding restricts deletion, so an in-use account cannot
// be detached silently.
model AwsCrossAccountBindingUsage {
  id         String                 @id @default(uuid()) @db.Uuid
  consumerId String                 @unique
  bindingId  String                 @db.Uuid
  binding    AwsCrossAccountBinding @relation(fields: [bindingId], references: [id])
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@schema("module/aws-identity")
}

// !! ------------------------------------------------------------ //
// !!              [Module] AWS Identity models                   //
// !! ------------------------------------------------------------ //
// * AwsCrossAccountBinding                                        //
// * v v v v v v v v v v v v v v v v v v v v v v v v v v v v v v v //

// Cross-account access is delegated through a customer-managed IAM role.
// The customer's role trust policy allows the host default account to
// assume the role with this binding's external ID; no long-lived access
// key is stored. A row may briefly exist with a null roleArn after
// bootstrap (the external ID has been generated but the role ARN has not
// been saved yet).
//
// projectId is the host scope ID (a project id / tenant id / ...). It is
// intentionally a plain column without a foreign key or a Prisma relation:
// this module never reads host tables and can be assembled into any host
// application. A missing host scope row simply means "not configured".
model AwsCrossAccountBinding {
  id             String    @id @default(uuid()) @db.Uuid
  projectId      String    @unique @db.Uuid
  roleArn        String?   @unique
  externalId     String    @unique
  awsAccountId   String?
  roleName       String?
  defaultRegion  String?
  regions        String[]
  lastVerifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@schema("module/aws-identity")
}

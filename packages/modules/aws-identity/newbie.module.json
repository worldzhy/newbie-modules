{
  "key": "aws-identity",
  "layer": "infrastructure",
  "wiring": {
    "file": "aws-identity.module",
    "className": "AwsIdentityModule",
    "prismaSchema": "prisma/schema.prisma"
  },
  "requires": {
    "modules": ["security"],
    "config": {
      "aws-identity": {
        "platformAccountId": "process.env.AWS_PLATFORM_ACCOUNT_ID"
      }
    },
    "env": {
      "AWS_PLATFORM_ACCOUNT_ID": ""
    },
    "dependencies": {
      "@aws-sdk/client-sts": "latest",
      "@aws-sdk/credential-provider-node": "latest"
    }
  }
}

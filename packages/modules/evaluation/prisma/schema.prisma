// Prisma schema fragment for the evaluation capability module (ADR-020).
// This file is managed by @devbie/newbie-cli — assembled into the consumer
// prisma tree on `newbie modules apply`.
//
// The skeleton holds no host vocabulary: no foreign keys point outside this
// schema, and every host-side identity is an opaque scalar (`requestedByRef`,
// `deciderRef`, `scopeId`).

// !! ----------------------------------------------------------- //
// !!                [Module] Evaluation models                   //
// !! ----------------------------------------------------------- //
// * EvaluationCriteriaVersion                                    //
// * EvaluationCriterion                                          //
// * EvaluationSubject                                            //
// * EvaluationRun                                                //
// * EvaluationResult                                             //
// * EvaluationFinding                                            //
// * EvaluationRemediationPlan                                    //
// * EvaluationCriterionKind (enum)                               //
// * EvaluationRunStatus (enum)                                   //
// * EvaluationFindingStatus (enum)                               //
// * EvaluationFindingSeverity (enum)                             //
// * EvaluationRemediationStatus (enum)                           //
// * EvaluationResultReviewStatus (enum)                          //
// ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

enum EvaluationCriterionKind {
  // Produces a verdict inside EvaluationResult.
  SCORED
  // Produces an EvaluationFinding that survives across runs.
  ASSERTION

  @@schema("module/evaluation")
}

enum EvaluationRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@schema("module/evaluation")
}

enum EvaluationFindingStatus {
  OPEN
  RESOLVED
  SUPPRESSED

  @@schema("module/evaluation")
}

enum EvaluationFindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("module/evaluation")
}

enum EvaluationRemediationStatus {
  OPEN
  COMPLETED
  CANCELLED

  @@schema("module/evaluation")
}

enum EvaluationResultReviewStatus {
  // Supervisor endorses the archived AI conclusion (ADR-031).
  APPROVED
  // Supervisor overrules the archived AI conclusion (ADR-031).
  REJECTED

  @@schema("module/evaluation")
}

/// A frozen set of criteria a run is judged against (ADR-020 D5.5). A draft is
/// editable; publishing is one-way, after which every write is rejected and
/// changes require a new version. `kind` is the subject kind these criteria
/// apply to; `evaluationKey` is the feature-defined group (rubric, aws-cis-1.5, ...).
model EvaluationCriteriaVersion {
  id     String @id @default(uuid()) @db.Uuid
  kind   String @db.VarChar(64)
  evaluationKey String @db.VarChar(64)

  version     String  @db.VarChar(64)
  description String? @db.Text
  // Feature-defined configuration shared by all criteria of the version
  metadata    Json?   @db.JsonB

  // Null while draft. Set once at publication; never cleared.
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  criteria EvaluationCriterion[]
  runs     EvaluationRun[]
  results  EvaluationResult[]

  @@unique([kind, evaluationKey, version])
  @@index([kind, evaluationKey, publishedAt])
  @@schema("module/evaluation")
}

/// One criterion inside a version. `criterionKey` is unique inside the version
/// and is the key verdicts and findings reference — never the row id, so a
/// result stays interpretable after the version is superseded.
model EvaluationCriterion {
  id                String @id @default(uuid()) @db.Uuid
  criteriaVersionId String @db.Uuid

  criterionKey String                  @db.VarChar(64)
  kind         EvaluationCriterionKind
  name         String                  @db.VarChar(255)
  description  String?                 @db.Text
  // Feature-defined judgment configuration (anchors, fact requirements,
  // control id); the judgment logic itself stays in the feature's code.
  metadata     Json?                   @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  criteriaVersion EvaluationCriteriaVersion @relation(fields: [criteriaVersionId], references: [id], onDelete: Cascade)

  @@unique([criteriaVersionId, criterionKey])
  @@index([criteriaVersionId])
  @@schema("module/evaluation")
}

/// The object being evaluated (ADR-020 D1). Identity is feature-defined through
/// `subjectKey`; the host assigns meaning to `scopeType` / `scopeId`, which are
/// plain scalars with no foreign key — this module knows no host entity.
model EvaluationSubject {
  id String @id @default(uuid()) @db.Uuid

  kind        String @db.VarChar(64)
  scopeType   String @db.VarChar(64)
  scopeId     String @db.VarChar(128)
  subjectKey  String @db.VarChar(255)
  displayName String @db.VarChar(255)

  metadata Json? @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs             EvaluationRun[]
  results          EvaluationResult[]
  findings         EvaluationFinding[]
  remediationPlans EvaluationRemediationPlan[]

  @@unique([kind, scopeType, scopeId, subjectKey])
  @@index([kind, scopeType, scopeId])
  @@schema("module/evaluation")
}

/// One evaluation attempt. Concurrency is enforced in the database, not in
/// process memory: a partial unique index over the active statuses on
/// (subjectId, criteriaVersionId) — the consumer migration must declare it in
/// raw SQL, Prisma cannot express partial indexes:
///
///   CREATE UNIQUE INDEX "EvaluationRun_one_active_per_subject_version"
///     ON "module/evaluation"."EvaluationRun" ("subjectId", "criteriaVersionId")
///     WHERE "status" IN ('QUEUED', 'RUNNING');
model EvaluationRun {
  id                String @id @default(uuid()) @db.Uuid
  subjectId         String @db.Uuid
  criteriaVersionId String @db.Uuid

  status EvaluationRunStatus @default(QUEUED)
  // Opaque host-side actor id; no foreign key by design
  requestedByRef String? @db.VarChar(128)
  // Opaque per-run feature config, threaded to the judgment port verbatim
  // (ADR-023). The skeleton never reads a key from it.
  config Json? @db.JsonB
  // Failure reason when status = FAILED. Message only, never a stack trace.
  error String? @db.Text

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  subject         EvaluationSubject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  criteriaVersion EvaluationCriteriaVersion @relation(fields: [criteriaVersionId], references: [id], onDelete: Restrict)

  // At most one result per run.
  result EvaluationResult?

  @@index([subjectId, criteriaVersionId])
  @@index([status])
  @@schema("module/evaluation")
}

/// The archived conclusion of one run (ADR-020 D5.1): `manifest`,
/// `contentHash` and `coverageStats` describe the material it was judged from
/// and are never rewritten — a rerun writes a new row. The supervisor review
/// columns (ADR-031) are the one lifecycle layer above the snapshot and never
/// touch it. There is deliberately no composite score field (D5.3); multi-axis
/// scores belong to the feature's read model.
model EvaluationResult {
  id                String @id @default(uuid()) @db.Uuid
  runId             String @unique @db.Uuid
  subjectId         String @db.Uuid
  criteriaVersionId String @db.Uuid

  // Archived evidence snapshot: [{ id, layer, source, summary, observedAt, refs }]
  manifest      Json    @db.JsonB
  // SHA-256 over the canonical manifest, computed by the skeleton
  contentHash   String  @db.VarChar(64)
  // { evaluated, declaredUnlinked, skipped } — each { total, bySource?, note?, items? }
  coverageStats Json    @db.JsonB

  // Scored verdicts: [{ criterionKey, score, confidence, coverage, evidenceRefs, rationale }]
  verdicts Json    @db.JsonB
  summary  String? @db.Text
  metadata Json?   @db.JsonB

  // Supervisor review of the archived conclusion (ADR-031). Every review is a
  // full-state write: a re-review overwrites reviewer, time and note, so the
  // row always reflects exactly the latest say.
  reviewStatus  EvaluationResultReviewStatus?
  // Opaque host-side actor id; no foreign key by design
  reviewedByRef String?                       @db.VarChar(128)
  reviewedAt    DateTime?
  reviewNote    String?                       @db.Text

  createdAt DateTime @default(now())

  run             EvaluationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  subject         EvaluationSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  criteriaVersion EvaluationCriteriaVersion @relation(fields: [criteriaVersionId], references: [id], onDelete: Restrict)

  @@index([subjectId, createdAt])
  @@index([criteriaVersionId])
  @@schema("module/evaluation")
}

/// An assertion-type conclusion (ADR-020 D2). Unlike a verdict it has an
/// identity — `(subjectId, evaluationKey, fingerprint)` — and a lifecycle that spans
/// runs: first seen once, last seen by whichever run still observed it,
/// resolved when it stops appearing. `evaluationKey` is copied from the run's
/// criteria version, so a rerun under a new version of the same evaluationKey keeps
/// the finding's identity, and one evaluationKey never resolves another evaluationKey's
/// findings. `firstSeenAt` is never rewritten.
model EvaluationFinding {
  id        String @id @default(uuid()) @db.Uuid
  subjectId String @db.Uuid

  // Criteria evaluationKey of the run that owns this finding's lifecycle
  evaluationKey       String                    @db.VarChar(64)
  // Stable identity of the assertion within the subject and evaluationKey
  fingerprint  String                    @db.VarChar(128)
  criterionKey String                    @db.VarChar(64)
  severity     EvaluationFindingSeverity
  status       EvaluationFindingStatus   @default(OPEN)

  title  String  @db.VarChar(255)
  detail String? @db.Text
  // Feature-defined extra material (evidence refs, signal tags, urgency inputs)
  metadata Json? @db.JsonB

  firstSeenRunId String? @db.Uuid
  lastSeenRunId  String? @db.Uuid

  firstSeenAt DateTime
  lastSeenAt  DateTime
  resolvedAt  DateTime?
  // Mandatory when status = SUPPRESSED: why a human silenced this finding
  suppressionNote String? @db.Text
  // Opaque host-side actor id of whoever suppressed the finding
  suppressedByRef String? @db.VarChar(128)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject EvaluationSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, evaluationKey, fingerprint])
  @@index([subjectId, status])
  @@index([status, severity])
  @@schema("module/evaluation")
}

/// The remediation object (ADR-020 D1): findings or results a plan answers to,
/// the checkpoints that track progress, and the named decider. `triggerRefs`
/// is validated against this schema's tables by the service — the plan can
/// never be anchored on material that does not exist.
model EvaluationRemediationPlan {
  id        String @id @default(uuid()) @db.Uuid
  subjectId String @db.Uuid

  status EvaluationRemediationStatus @default(OPEN)

  // Finding or result ids that triggered the plan; validated by the service
  triggerRefs Json @db.JsonB
  // The named decision maker (opaque host-side actor id) — required by D1
  deciderRef  String @db.VarChar(128)

  startDate DateTime
  dueDate   DateTime?
  // [{ dueDate, description, status }]
  checkpoints Json? @db.JsonB

  // completed / failed / extended, recorded when the plan closes
  decisionNote String?   @db.Text
  decidedAt    DateTime?
  // Opaque host-side actor id of whoever recorded the decision; `deciderRef`
  // names the accountable decision maker, this records who actually acted
  decidedByRef String?   @db.VarChar(128)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject EvaluationSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, status])
  @@schema("module/evaluation")
}

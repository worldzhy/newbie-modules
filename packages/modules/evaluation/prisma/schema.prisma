// Prisma schema fragment for the evaluation capability module (ADR-020).
// This file is managed by @devbie/newbie-cli — assembled into the consumer
// prisma tree on `newbie modules apply`.
//
// The skeleton holds no host vocabulary: no foreign keys point outside this
// schema, and every host-side identity is an opaque scalar (`requestedBy`,
// `decider`). Operator columns are deliberately absent — who performed an
// action is audited outside the skeleton (ADR-068).

// !! ----------------------------------------------------------- //
// !!                [Module] Evaluation models                   //
// !! ----------------------------------------------------------- //
// * EvaluationRuleSetVersion                                    //
// * EvaluationCriterion                                          //
// * EvaluationSubject                                            //
// * EvaluationRun                                                //
// * EvaluationResult                                             //
// * EvaluationFinding                                            //
// * EvaluationRemediationPlan                                    //
// * EvaluationCriterionKind (enum)                               //
// * EvaluationRunStatus (enum)                                   //
// * EvaluationFindingStatus (enum)                               //
// * EvaluationFindingSeverity (enum)                             //
// * EvaluationRemediationStatus (enum)                           //
// * EvaluationResultReviewStatus (enum)                          //
// ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

enum EvaluationCriterionKind {
  // Produces a verdict inside EvaluationResult.
  SCORED
  // Produces an EvaluationFinding that survives across runs.
  ASSERTION

  @@schema("module/evaluation")
}

enum EvaluationRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED

  @@schema("module/evaluation")
}

enum EvaluationFindingStatus {
  OPEN
  RESOLVED
  SUPPRESSED

  @@schema("module/evaluation")
}

enum EvaluationFindingSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("module/evaluation")
}

enum EvaluationRemediationStatus {
  OPEN
  COMPLETED
  CANCELLED

  @@schema("module/evaluation")
}

enum EvaluationResultReviewStatus {
  // Supervisor endorses the archived AI conclusion (ADR-031).
  APPROVED
  // Supervisor overrules the archived AI conclusion (ADR-031).
  REJECTED

  @@schema("module/evaluation")
}

/// A frozen set of criteria a run is judged against (ADR-020 D5.5). A draft is
/// editable; publishing is one-way, after which every write is rejected and
/// changes require a new version. `subjectKind` is the subject kind these
/// criteria apply to; `standardKey` is the feature-defined group (rubric,
/// aws-cis-1.5, ...).
model EvaluationRuleSetVersion {
  id          String @id @default(uuid()) @db.Uuid
  subjectKind String @db.VarChar(64)
  standardKey String @db.VarChar(64)

  version     String  @db.VarChar(64)
  description String? @db.Text
  // Feature-defined configuration shared by all criteria of the version
  metadata    Json?   @db.JsonB

  // Null while draft. Set once at publication; never cleared.
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  criteria EvaluationCriterion[]
  runs     EvaluationRun[]
  results  EvaluationResult[]

  @@unique([subjectKind, standardKey, version])
  @@index([subjectKind, standardKey, publishedAt])
  @@schema("module/evaluation")
}

/// One criterion inside a version. `criterionKey` is unique inside the version
/// and is the key verdicts and findings reference — never the row id, so a
/// result stays interpretable after the version is superseded.
model EvaluationCriterion {
  id                String @id @default(uuid()) @db.Uuid
  ruleSetVersionId String @db.Uuid

  criterionKey String                  @db.VarChar(64)
  kind         EvaluationCriterionKind
  name         String                  @db.VarChar(255)
  description  String?                 @db.Text
  // Feature-defined judgment configuration (anchors, fact requirements,
  // control id); the judgment logic itself stays in the feature's code.
  metadata     Json?                   @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ruleSetVersion EvaluationRuleSetVersion @relation(fields: [ruleSetVersionId], references: [id], onDelete: Cascade)

  @@unique([ruleSetVersionId, criterionKey])
  @@index([ruleSetVersionId])
  @@schema("module/evaluation")
}

/// The object being evaluated (ADR-020 D1, ADR-068, ADR-069). Identity is
/// `(subjectType, kind, subjectKey)` — all three feature-defined; the skeleton
/// never derives them and knows no host entity. `subjectType` names the feature
/// that submits the subject, so two features may evaluate the same kind without
/// sharing a row.
///
/// `credentialRef` is an opaque pointer the feature may register at ingest time
/// when evaluating the subject requires host-held credentials (e.g. a cloud
/// account binding). The skeleton stores and returns it verbatim; it never
/// parses, resolves or dereferences it, and it plays no role in subject
/// identity, provenance or authorization.
model EvaluationSubject {
  id String @id @default(uuid()) @db.Uuid

  // Owning feature key (e.g. "security-evaluation"); opaque to the skeleton
  subjectType String @db.VarChar(64)
  kind        String @db.VarChar(64)
  subjectKey  String @db.VarChar(255)
  displayName String @db.VarChar(255)

  // Opaque host-side credential pointer; feature-defined, never resolved here
  credentialRef String? @db.VarChar(255)

  metadata Json? @db.JsonB

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs             EvaluationRun[]
  results          EvaluationResult[]
  findings         EvaluationFinding[]
  remediationPlans EvaluationRemediationPlan[]

  @@unique([subjectType, kind, subjectKey])
  @@schema("module/evaluation")
}

/// One evaluation attempt. Concurrency is enforced in the database, not in
/// process memory: a partial unique index over the active statuses on
/// (subjectId, ruleSetVersionId) — the consumer migration must declare it in
/// raw SQL, Prisma cannot express partial indexes:
///
///   CREATE UNIQUE INDEX "EvaluationRun_one_active_per_subject_version"
///     ON "module/evaluation"."EvaluationRun" ("subjectId", "ruleSetVersionId")
///     WHERE "status" IN ('QUEUED', 'RUNNING');
model EvaluationRun {
  id                String @id @default(uuid()) @db.Uuid
  subjectId         String @db.Uuid
  ruleSetVersionId String @db.Uuid

  status EvaluationRunStatus @default(QUEUED)
  // Opaque host-side actor id; no foreign key by design
  requestedBy String? @db.VarChar(128)
  // Opaque per-run feature config, threaded to the judgment port verbatim
  // (ADR-023). The skeleton never reads a key from it.
  judgmentConfig Json? @db.JsonB
  // Failure reason when status = FAILED. Message only, never a stack trace.
  failureReason String? @db.Text

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  subject         EvaluationSubject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  ruleSetVersion EvaluationRuleSetVersion @relation(fields: [ruleSetVersionId], references: [id], onDelete: Restrict)

  // At most one result per run.
  result EvaluationResult?

  firstSeenFindings EvaluationFinding[] @relation("EvaluationFindingFirstSeenRun")
  lastSeenFindings  EvaluationFinding[] @relation("EvaluationFindingLastSeenRun")

  @@index([subjectId, ruleSetVersionId])
  @@index([status])
  @@schema("module/evaluation")
}

/// The archived conclusion of one run (ADR-020 D5.1): `evidenceManifest`,
/// `manifestHash` and `coverageStats` describe the material it was judged from
/// and are never rewritten — a rerun writes a new row. The supervisor review
/// columns (ADR-031) are the one lifecycle layer above the snapshot and never
/// touch it. There is deliberately no composite score field (D5.3); multi-axis
/// scores belong to the feature's read model.
model EvaluationResult {
  id                String @id @default(uuid()) @db.Uuid
  runId             String @unique @db.Uuid
  subjectId         String @db.Uuid
  ruleSetVersionId String @db.Uuid

  // Archived evidence snapshot: [{ id, layer, source, summary, observedAt, refs }]
  evidenceManifest Json    @db.JsonB
  // SHA-256 over the canonical evidence manifest, computed by the skeleton
  manifestHash    String  @db.VarChar(64)
  // { evaluated, declaredUnlinked, skipped } — each { total, bySource?, note?, items? }
  coverageStats Json    @db.JsonB

  // Scored verdicts: [{ criterionKey, score, confidence, coverage, evidenceRefs, rationale }]
  verdicts Json    @db.JsonB
  summary  String? @db.Text
  metadata Json?   @db.JsonB

  // Supervisor review of the archived conclusion (ADR-031). Every review is a
  // full-state write: a re-review overwrites time and note, so the row always
  // reflects exactly the latest say. The actor is not stored here (ADR-068 D6):
  // it is always the requester, and the audit log already records it.
  reviewStatus  EvaluationResultReviewStatus?
  reviewedAt    DateTime?
  reviewNote    String?                       @db.Text

  createdAt DateTime @default(now())

  run             EvaluationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  subject         EvaluationSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  ruleSetVersion EvaluationRuleSetVersion @relation(fields: [ruleSetVersionId], references: [id], onDelete: Restrict)

  @@index([subjectId, createdAt])
  @@index([ruleSetVersionId])
  @@schema("module/evaluation")
}

/// An assertion-type conclusion (ADR-020 D2). Unlike a verdict it has an
/// identity — `(subjectId, standardKey, fingerprint)` — and a lifecycle that spans
/// runs: first seen once, last seen by whichever run still observed it,
/// resolved when it stops appearing. `standardKey` is copied from the run's
/// criteria version, so a rerun under a new version of the same standardKey keeps
/// the finding's identity, and one standardKey never resolves another standardKey's
/// findings. `firstSeenAt` is never rewritten.
model EvaluationFinding {
  id        String @id @default(uuid()) @db.Uuid
  subjectId String @db.Uuid

  // Criteria standardKey of the run that owns this finding's lifecycle
  standardKey         String                    @db.VarChar(64)
  // Stable identity of the assertion within the subject and standardKey
  fingerprint  String                    @db.VarChar(128)
  criterionKey String                    @db.VarChar(64)
  severity     EvaluationFindingSeverity
  status       EvaluationFindingStatus   @default(OPEN)

  title       String  @db.VarChar(255)
  description String? @db.Text
  // Feature-defined extra material (evidence refs, signal tags, urgency inputs)
  metadata Json? @db.JsonB

  firstSeenRunId String? @db.Uuid
  lastSeenRunId  String? @db.Uuid

  firstSeenAt DateTime
  lastSeenAt  DateTime
  resolvedAt  DateTime?
  // Mandatory when status = SUPPRESSED: why a human silenced this finding
  suppressionNote String? @db.Text
  suppressedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject      EvaluationSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  firstSeenRun EvaluationRun?    @relation("EvaluationFindingFirstSeenRun", fields: [firstSeenRunId], references: [id], onDelete: SetNull)
  lastSeenRun  EvaluationRun?    @relation("EvaluationFindingLastSeenRun", fields: [lastSeenRunId], references: [id], onDelete: SetNull)

  @@unique([subjectId, standardKey, fingerprint])
  @@index([subjectId, status])
  @@index([status, severity])
  @@schema("module/evaluation")
}

/// The remediation object (ADR-020 D1): findings or results a plan answers to,
/// the checkpoints that track progress, and the named decider. `triggerIds`
/// is validated against this schema's tables by the service — the plan can
/// never be anchored on material that does not exist.
model EvaluationRemediationPlan {
  id        String @id @default(uuid()) @db.Uuid
  subjectId String @db.Uuid

  status EvaluationRemediationStatus @default(OPEN)

  // Finding or result ids that triggered the plan; validated by the service
  triggerIds Json @db.JsonB
  // The named decision maker (opaque host-side actor id) — required by D1
  decider String @db.VarChar(128)

  startOn DateTime  @db.Date
  dueOn   DateTime? @db.Date
  // [{ dueDate, description, status }]
  checkpoints Json? @db.JsonB

  // completed / failed / extended, recorded when the plan closes
  decisionNote String?   @db.Text
  decidedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject EvaluationSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId, status])
  @@schema("module/evaluation")
}

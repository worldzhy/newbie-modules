{
  "key": "mongo",
  "layer": "datastore",
  "wiring": {
    "file": "mongo.module",
    "className": "MongoModule"
  },
  "requires": {
    "config": {
      "mongo": {
        "uri": "process.env.MONGO_URL"
      }
    },
    "env": {
      "MONGO_URL": ""
    }
  },
  "dependencies": {
    "@nestjs/mongoose": "^11.0.4",
    "mongoose": "^7.8.12"
  }
}

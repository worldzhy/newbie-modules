// * FrontendMonitorInstallation                                   //
// !! ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

// One row per frontend application whose browser SDK reports to
// /frontend-monitor/report, identified by its report token. The token is a
// random UUID; only its SHA-256 hash is stored, the plaintext is returned once
// at enrollment or rotation, and revocation is a soft delete.
//
// `appKey` is an immutable public partition key embedded in Mongo collection
// names (WebPages_<appKey>) and ClickHouse table names
// (frontend_monitor_requests_<appKey>). It is generated at enrollment and never
// rotated.
//
// Host-side grouping stays in opaque `externalRef` (convention:
// "projectId/applicationId"); the application layer matches on it to render
// credential state. Cross-schema references use scalar ids, never foreign keys.
//
// Liveness is derived from `lastSeenAt`, not stored: never seen (null), online,
// or stale after three minutes without a report. Only revocation is persisted
// explicitly.
model FrontendMonitorInstallation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Human-readable label set at enrollment, e.g. "nightwatch-frontend-monitor".
  label String @db.VarChar(255)
  // SHA-256 hex of the report token. The plaintext token is returned once at
  // creation or rotation and never stored.
  tokenHash String @unique @db.VarChar(64)

  // Public partition key embedded in storage names; never rotated.
  appKey String @unique @db.VarChar(64)

  // Opaque platform-owned tag (convention: "projectId/applicationId").
  externalRef String? @db.VarChar(255)

  firstSeenAt DateTime?
  lastSeenAt  DateTime?

  // Soft revocation: reports are rejected (401); rows are retained for history.
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("module/frontend-monitor")
}

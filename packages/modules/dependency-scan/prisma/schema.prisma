// !!               [Module] Dependency Scan models                        //
// !! ------------------------------------------------------------ //
// * DependencyScan                                                       //
// * DependencyScanFinding                                                //
// * ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ //

// One dependency vulnerability scan execution for a single Application.
// Scans fetch the repository lockfile via the GitHub API and match locked
// package versions against the OSV vulnerability database.
model DependencyScan {
  id            String    @id @default(uuid()) @db.Uuid
  applicationId String    @db.Uuid
  status        String    @db.VarChar(30)
  errorMessage  String?   @db.Text
  summary       Json?
  report        Json?
  repositoryUrl String?   @db.VarChar(512)
  lockfilePath  String?   @db.VarChar(255)
  packageCount  Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  startedAt     DateTime?
  finishedAt    DateTime?

  @@index([applicationId])
  @@index([applicationId, createdAt])
  @@schema("module/dependency-scan")
}

// Deduplicated, cross-scan persistent finding. One row per
// (application, packageName, vulnId) tuple; upserted after every successful
// scan so trends and project-level roll-ups can be derived without re-parsing
// the report JSON blob on DependencyScan. The installed version is a mutable field on
// the row, not part of the fingerprint: upgrading to another still-affected
// version keeps the same finding open.
model DependencyScanFinding {
  id             String    @id @default(uuid()) @db.Uuid
  applicationId  String    @db.Uuid
  projectId      String    @db.Uuid
  scanId         String?   @db.Uuid
  fingerprint    String    @unique
  ecosystem      String    @db.VarChar(20)
  packageName    String    @db.VarChar(255)
  packageVersion String    @db.VarChar(100)
  isDev          Boolean   @default(false)
  vulnId         String    @db.VarChar(50)
  aliases        String[]
  severity       String    @db.VarChar(10)
  title          String    @db.VarChar(512)
  detail         String?   @db.Text
  fixedVersion   String?   @db.VarChar(100)
  status         String    @default("open") @db.VarChar(20)
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([applicationId])
  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, severity])
  @@schema("module/dependency-scan")
}

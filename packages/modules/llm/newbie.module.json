{
  "key": "llm",
  "layer": "infrastructure",
  "module": {
    "file": "llm.module",
    "className": "LlmModule"
  },
  "schema": "prisma/schema.prisma",
  "moduleDependencies": ["security"],
  "config-service": {
    "llm": {
      "apiKeySecret": "process.env.LLM_API_KEY_SECRET || process.env.SECURITY_USER_REFRESH_TOKEN_SECRET"
    }
  },
  "env": {
    "LLM_API_KEY_SECRET": ""
  },
  "dependencies": {
    "ai": "^6.0.301",
    "@ai-sdk/provider": "^3.0.18",
    "@ai-sdk/openai-compatible": "^2.0.81",
    "@ai-sdk/anthropic": "^3.0.128"
  },
  "devDependencies": {}
}

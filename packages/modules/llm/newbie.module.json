{
  "key": "llm",
  "layer": "infrastructure",
  "wiring": {
    "file": "llm.module",
    "className": "LlmModule",
    "prismaSchema": "prisma/schema.prisma"
  },
  "requires": {
    "modules": ["security"],
    "config": {
      "llm": {
        "apiKeySecret": "process.env.LLM_API_KEY_SECRET"
      }
    },
    "env": {
      "LLM_API_KEY_SECRET": ""
    },
    "dependencies": {
      "ai": "^6.0.301",
      "@ai-sdk/provider": "^3.0.18",
      "@ai-sdk/openai-compatible": "^2.0.81",
      "@ai-sdk/anthropic": "^3.0.128"
    },
    "devDependencies": {}
  }
}

// !! ------------------------------------------------------------ //
// !!                     [Module] LLM models                      //
// !! ------------------------------------------------------------ //
// * LlmConnection                                                 //
// * LlmScopeAssignment                                            //
// !! ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

// One upstream credential (ADR-006): provider + baseUrl + apiKey, plus the
// model it currently serves. The (baseUrl, apiKey) pair is a uniqueness
// invariant rather than the row identity, so the key or the model can be
// edited in place while scope bindings stay attached. `apiKey` is ciphertext
// at rest (AES-256-GCM, see management/llm-api-key.ts), so the check compares
// the deterministic `apiKeyFingerprint` instead. Many consumer scopes can bind
// one connection through LlmScopeAssignment.
model LlmConnection {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  // Wire protocol: "openai-compatible" or "anthropic". A string rather than an
  // enum so a new provider kind needs no migration.
  provider  String   @default("openai-compatible") @db.VarChar(40)
  model     String   @db.VarChar(255)
  // Required for openai-compatible; the empty string selects the official
  // https://api.anthropic.com endpoint for anthropic. NOT NULL throughout.
  baseUrl   String   @db.VarChar(255)
  // Ciphertext (`enc:v1:<base64>`), hence wider than the 500-char plaintext
  // cap declared by the DTO. Legacy plaintext rows remain readable.
  apiKey    String   @db.VarChar(1000)
  // SHA-256 of the plaintext key: the credential identity behind the
  // uniqueness invariant and duplicate pre-checks. Null on legacy rows.
  apiKeyFingerprint String? @db.VarChar(64)

  // Health snapshot shared by every scope using this connection; null means
  // never called.
  lastCallAt          DateTime?
  lastCallSuccess     Boolean?
  lastFailureCategory String? @db.VarChar(20)
  lastFailureMessage  String? @db.VarChar(500)

  scopes    LlmScopeAssignment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One credential against one upstream endpoint exists at most once: a
  // duplicated (baseUrl, apiKey) pair never yields a second row, which keeps
  // key rotation a single-row update for every scope bound to it. PostgreSQL
  // allows multiple NULL fingerprints, so legacy rows coexist with the
  // encrypted ones until an admin re-saves them.
  @@unique([baseUrl, apiKeyFingerprint])
  @@schema("module/llm")
}

// Binds one opaque consumer scope ("copilot", "analysis", ...) to a connection
// (ADR-006). `scope` is unique, so a scope binds to exactly one connection
// while a connection can serve many scopes; deleting a connection cascades to
// its assignments.
model LlmScopeAssignment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope        String   @unique @db.VarChar(64)
  connectionId String   @db.Uuid
  connection   LlmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("module/llm")
}

// !! ------------------------------------------------------------ //
// !!            [Module] LLM models                               //
// !! ------------------------------------------------------------ //
// * LlmConnection (provider + baseUrl + apiKey + current model — one credential endpoint) //
// * LlmScopeAssignment (scope → connectionId —— consumer-to-connection binding) //
// * ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ //

// LLM connection configuration (ADR-006). One row = one upstream credential
// (provider + baseUrl + apiKey) plus the model it currently serves. The
// (baseUrl, apiKey) pair is a uniqueness invariant, not the row identity, so
// the key or model can be edited in place while scope bindings stay attached.
// Multiple consumer scopes can bind to the same connection via LlmScopeAssignment.
model LlmConnection {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  // Wire protocol: "openai-compatible" or "anthropic". Kept as a string so
  // a future provider kind does not require an enum migration.
  provider  String   @default("openai-compatible") @db.VarChar(40)
  model     String   @db.VarChar(255)
  // Required for openai-compatible. Empty string for anthropic means the
  // official https://api.anthropic.com endpoint (column stays NOT NULL).
  baseUrl   String   @db.VarChar(255)
  apiKey    String   @db.VarChar(500)

  // Health snapshot — shared across all scopes using this connection.
  // Null = never called.
  lastCallAt          DateTime?
  lastCallSuccess     Boolean?
  lastFailureCategory String? @db.VarChar(20)
  lastFailureMessage  String? @db.VarChar(500)

  scopes    LlmScopeAssignment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One credential against one upstream endpoint exists at most once: a
  // duplicated (baseUrl, apiKey) pair never yields a second row, which keeps
  // key rotation a single-row update for every scope bound to it.
  @@unique([baseUrl, apiKey])
  @@schema("module/llm")
}

// Consumer-scope binding (ADR-006). Maps an opaque scope string ("copilot",
// "analysis", "jdy", ...) to a connection. One scope binds to exactly one
// connection (scope is unique); a connection can serve many scopes. Deleting
// a connection cascades to all its assignments.
model LlmScopeAssignment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope        String   @unique @db.VarChar(64)
  connectionId String   @db.Uuid
  connection   LlmConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("module/llm")
}

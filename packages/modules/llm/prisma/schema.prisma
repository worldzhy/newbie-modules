// !! ------------------------------------------------------------ //
// !!            [Module] LLM models                               //
// !! ------------------------------------------------------------ //
// * LlmModel (unified LLM model configuration, one active per scope) //
// * ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ //

// Unified LLM model configuration (ADR-005). The LLM module owns its own
// Postgres schema; the per-scope single-active guarantee lives in a partial
// unique index (Postgres WHERE clause) created by the host-side migration
// that moves the legacy CopilotModel table into "module/llm" as LlmModel.
model LlmModel {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Opaque consumer scope, e.g. "copilot", "ai-analysis", "jdy". Consumers
  // hardcode their own constant; activation is unique per scope.
  scope     String   @db.VarChar(64)
  name      String   @db.VarChar(255)
  // Wire protocol: "openai-compatible" or "anthropic". Kept as a string so
  // a future provider kind does not require an enum migration.
  provider  String   @default("openai-compatible") @db.VarChar(40)
  model     String   @db.VarChar(255)
  // Required for openai-compatible. Empty string for anthropic means the
  // official https://api.anthropic.com endpoint (column stays NOT NULL).
  baseUrl   String   @db.VarChar(255)
  apiKey    String   @db.VarChar(500)
  isActive  Boolean  @default(false)
  // Current-state snapshot of the last model-call outcome (any consumer).
  // History lives in the audit stream; the UI surfaces only this fold.
  // Null = never called.
  lastCallAt          DateTime?
  lastCallSuccess     Boolean?
  lastFailureCategory String? @db.VarChar(20)
  lastFailureMessage  String? @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("module/llm")
}

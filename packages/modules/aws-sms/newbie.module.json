{
  "key": "aws-sms",
  "layer": "foundation",
  "module": {
    "file": "aws-sms.module",
    "className": "AwsSmsModule"
  },
  "config-service": {
    "aws-sms": {
      "region": "process.env.AWS_SMS_REGION || 'us-east-1'",
      "configurationSetName": "process.env.AWS_SMS_CONFIGURATION_SET_NAME"
    }
  },
  "env": {
    "AWS_SMS_REGION": "",
    "AWS_SMS_CONFIGURATION_SET_NAME": ""
  },
  "dependencies": {
    "@aws-sdk/client-pinpoint-sms-voice-v2": "latest"
  },
  "devDependencies": {}
}

// ! ------------------------------------------------------------ //
// !          [Module] Application hosting stacks             //
// ! ------------------------------------------------------------ //

/// Mirrors the AWS CloudFormation stack status this module last observed.
/// The module reports AWS facts; it does not decide whether an application
/// deployment succeeded.
enum AwsResourceStackState {
  PENDING
  CREATE_IN_PROGRESS
  CREATE_COMPLETE
  CREATE_FAILED
  DELETE_IN_PROGRESS
  DELETE_COMPLETE
  DELETE_FAILED

  @@schema("module/aws-cloudformation")
}

/// A cross-account target: the host assumes `roleArn` in `awsAccountId` on
/// every AWS call. No long-lived access key is stored.
model AwsEnvironment {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  awsAccountId String
  awsRegion    String
  roleArn      String
  externalId   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  stacks       AwsResourceStack[]

  @@schema("module/aws-cloudformation")
}

model AwsResourceStack {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String?               @unique // Set default value via prisma extension.
  type                String
  params              Json?
  state               AwsResourceStackState @default(PENDING)
  createStackOutput   Json?
  describeStackOutput Json?
  deleteStackOutput   Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  environment         AwsEnvironment        @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  environmentId       String                @db.Uuid

  @@schema("module/aws-cloudformation")
}

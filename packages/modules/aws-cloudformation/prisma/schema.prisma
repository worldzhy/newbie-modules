/// CloudFormation stack status as last observed by this module. The module
/// reports AWS state; it does not decide whether an application deployment
/// succeeded.
enum AwsResourceStackState {
  PENDING
  CREATE_IN_PROGRESS
  CREATE_COMPLETE
  CREATE_FAILED
  DELETE_IN_PROGRESS
  DELETE_COMPLETE
  DELETE_FAILED

  @@schema("module/aws-cloudformation")
}

/// One target account and region that stacks are deployed into. Every AWS call
/// assumes `roleArn` in `awsAccountId`; no long-lived access key is stored.
model AwsEnvironment {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  awsAccountId String
  awsRegion    String
  roleArn      String
  externalId   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  stacks       AwsResourceStack[]

  @@schema("module/aws-cloudformation")
}

model AwsResourceStack {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String?               @unique // Default generated by a Prisma extension.
  type                String
  params              Json?
  state               AwsResourceStackState @default(PENDING)
  createStackOutput   Json?
  describeStackOutput Json?
  deleteStackOutput   Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  environment         AwsEnvironment        @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  environmentId       String                @db.Uuid

  @@schema("module/aws-cloudformation")
}

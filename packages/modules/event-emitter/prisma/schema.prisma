// !           [Module] Event emitter models              //
// ! ------------------------------------------------------------ //
// * EventEmission                                                //
// * ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

/// One recorded event emission. `listenerCount` snapshots how many listeners
/// were subscribed at emission time; `payload` is the JSON-normalized emission
/// payload (NULL when the emitter sent none). The event catalog itself lives
/// in memory (EventCatalogService) — only what actually fired is persisted.
model EventEmission {
  id            Int      @id @default(autoincrement())
  eventKey      String
  payload       Json?
  listenerCount Int      @default(0)
  emittedAt     DateTime @default(now())

  @@index([eventKey, emittedAt])
  @@index([emittedAt])
  @@schema("module/event-emitter")
}

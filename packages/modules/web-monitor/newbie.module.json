{
  "key": "web-monitor",
  "layer": "feature",
  "publicNamespace": true,
  "role": "collector",
  "module": {
    "file": "web-monitor.module",
    "className": "WebMonitorModule"
  },
  "schema": "prisma/schema.prisma",
  "moduleDependencies": ["audit", "clickhouse", "event-emitter", "mongo", "redis", "security"],
  "sdk": "@devbie/web-monitor-sdk",
  "config-service": {
    "web-monitor": {
      "TENCENTMAPKEY": "process.env.WEB_MONITOR_TENCENT_MAP_KEY"
    }
  },
  "env": {
    "WEB_MONITOR_TENCENT_MAP_KEY": ""
  },
  "dependencies": {
    "@nestjs/event-emitter": "latest",
    "@nestjs/schedule": "latest",
    "cron-parser": "4.x",
    "dotenv": "latest",
    "ua-parser-js": "latest"
  },
  "devDependencies": {}
}

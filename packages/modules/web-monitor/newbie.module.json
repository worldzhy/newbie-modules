{
  "key": "web-monitor",
  "layer": "feature",
  "wiring": {
    "file": "web-monitor.module",
    "className": "WebMonitorModule",
    "prismaSchema": "prisma/schema.prisma"
  },
  "collector": {
    "peerSdk": "@devbie/web-monitor-sdk"
  },
  "requires": {
    "modules": ["audit", "clickhouse", "event-emitter", "mongo", "redis", "security"],
    "config": {
      "web-monitor": {
        "TENCENTMAPKEY": "process.env.WEB_MONITOR_TENCENT_MAP_KEY"
      }
    },
    "env": {
      "WEB_MONITOR_TENCENT_MAP_KEY": ""
    },
    "dependencies": {
      "@nestjs/event-emitter": "latest",
      "@nestjs/schedule": "latest",
      "cron-parser": "4.x",
      "dotenv": "latest",
      "ua-parser-js": "latest"
    },
    "devDependencies": {}
  }
}

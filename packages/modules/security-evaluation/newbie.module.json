{
  "key": "security-evaluation",
  "layer": "feature",
  "wiring": {
    "file": "security-evaluation.module",
    "className": "SecurityEvaluationModule",
    "prismaSchema": "prisma/schema.prisma"
  },
  "requires": {
    "modules": ["evaluation", "security", "llm"],
    "config": {
      "security-evaluation": {
        "ttlDays": "process.env.NEGATIVE_CACHE_TTL_DAYS"
      }
    },
    "env": {
      "NEGATIVE_CACHE_TTL_DAYS": {
        "type": "int",
        "example": 7,
        "description": "Days to keep 'not-relevant' verdict cache rows before they expire. Hard-hit rows are audit-only and never expire."
      }
    }
  },
  "dependencies": {}
}

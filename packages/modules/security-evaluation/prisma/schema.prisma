// Prisma schema fragment for the security-evaluation module (ADR-022).
// This file is managed by @devbie/newbie-cli — assembled into the
// consumer prisma tree on `newbie modules apply`.
//
// The run / result / criteria / finding tables belong to the evaluation
// skeleton (`module/evaluation`, ADR-020). This feature only owns the asset
// inventory: `subjectId` is a plain scalar with no relation — foreign keys
// never cross schema boundaries.

// !! ----------------------------------------------------------- //
// !!            [Module] Security Evaluation models             //
// !! ----------------------------------------------------------- //
// * SecurityEvaluationAsset                                   //
// * SecurityEvaluationAssetSource                             //
// * SecurityEvaluationAwsConfigKnowledgeItem                  //
// * SecurityEvaluationNpmPackageKnowledgeItem                 //
// ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

/// One evaluated asset, one-to-one with an EvaluationSubject row of this
/// feature's kinds ("repository" / "aws-account"). The skeleton owns the
/// subject coordinate; this table owns the asset's inventory lifecycle.
/// `naturalKey` is the feature's stable identity inside its scope — a
/// repository full name or an AWS account id.
model SecurityEvaluationAsset {
  id          String   @id @default(uuid()) @db.Uuid
  // EvaluationSubject.id in "module/evaluation"; scalar, no FK
  subjectId   String   @unique @db.Uuid
  naturalKey  String   @db.VarChar(512)
  displayName String   @db.VarChar(255)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  awsConfigKnowledgeItems   SecurityEvaluationAwsConfigKnowledgeItem[]
  npmPackageKnowledgeItems  SecurityEvaluationNpmPackageKnowledgeItem[]

  @@index([naturalKey])
  @@schema("module/security-evaluation")
}

/// Provenance of a subject: which host source submitted it (ADR-039). A
/// platform-level subject may be supplied by several sources — the same
/// repository can back applications of two projects, so the relation is many
/// to many and the row set is what "who contributed this asset" means.
///
/// `sourceType` / `sourceId` are opaque strings: the module never resolves them
/// to a host entity, it only stores and filters them. Provenance is used for
/// display and remediation routing, never for authorization.
model SecurityEvaluationAssetSource {
  id              String   @id @default(uuid()) @db.Uuid
  // EvaluationSubject.id in "module/evaluation"; scalar, no FK
  subjectId       String   @db.Uuid
  sourceType      String   @db.VarChar(64)
  sourceId        String   @db.VarChar(128)
  firstSubmittedAt DateTime @default(now())
  lastSubmittedAt  DateTime @default(now())

  @@unique([subjectId, sourceType, sourceId])
  @@index([sourceType, sourceId])
  @@schema("module/security-evaluation")
}

/// A current-state AWS configuration knowledge item collected from an asset:
/// a password policy, an access key, a bucket's security posture… Items are
/// upserted on collection and never deleted here; history lives in the
/// archived run manifest, and a stale `observedAt` is what "not observed
/// recently" means.
///
/// The KnowledgeItem suffix marks the knowledge family — collected/external
/// knowledge consumed by judgment — not schema isomorphism across the
/// family: this table is asset-scoped while SecurityEvaluationThreatKnowledgeItem
/// is world-scoped (ADR-037 D9.1).
model SecurityEvaluationAwsConfigKnowledgeItem {
  id         String   @id @default(uuid()) @db.Uuid
  assetId    String   @db.Uuid
  type       String   @db.VarChar(64) // "aws.iam.account-password-policy" | ...
  key        String   @db.VarChar(512) // stable identity within the type
  value      Json?    @db.JsonB // small intrinsic values: region, mfaEnabled…
  observedAt DateTime

  asset SecurityEvaluationAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, type, key])
  @@index([assetId, type])
  @@schema("module/security-evaluation")
}

/// A current-state npm package knowledge item collected from a repository
/// asset: the package installed at a version. Same lifecycle and family
/// semantics as SecurityEvaluationAwsConfigKnowledgeItem.
model SecurityEvaluationNpmPackageKnowledgeItem {
  id         String   @id @default(uuid()) @db.Uuid
  assetId    String   @db.Uuid
  type       String   @db.VarChar(64) // "npm.package"
  key        String   @db.VarChar(512) // "npm:lodash@4.17.20"
  value      Json?    @db.JsonB // small intrinsic values: version, isDev, ecosystem…
  observedAt DateTime

  asset SecurityEvaluationAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, type, key])
  @@index([assetId, type])
  @@schema("module/security-evaluation")
}

// !! ----------------------------------------------------------- //
// !!            [Module] Security Evaluation Knowledge          //
// !! ----------------------------------------------------------- //
// * SecurityEvaluationThreatKnowledgeItem                      //
// ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

/// One piece of external threat intelligence, deduplicated by
/// (source, externalId). One row per unique intel item; re-fetching the
/// same item refreshes rawPayload and bumps lastSeenAt. fetchedAt stays at
/// the first-seen time on purpose: the match pipeline walks it oldest-first
/// so every collection batch eventually gets evaluated.
///
/// Ported from the former threat-intelligence module (ADR-039); fields and
/// indexes are unchanged.
///
/// World-scoped: unlike the asset-scoped knowledge tables above, a threat
/// item belongs to no asset — it exists once per source and is matched
/// against every asset's knowledge during judgment.
model SecurityEvaluationThreatKnowledgeItem {
  id          String   @id @default(uuid()) @db.Uuid
  source      String   @db.VarChar(50)
  category    String   @db.VarChar(30)
  // Stable identifier within the source: CVE ID, ecosystem+package,
  // vendor+event-id, or a title fingerprint. Together with `source` it
  // forms the deduplication key.
  externalId  String   @db.VarChar(512)
  title       String   @db.VarChar(1024)
  summary     String?  @db.Text
  url         String?  @db.VarChar(1024)
  publishedAt DateTime?
  severity    String   @default("info") @db.VarChar(15)
  // Signal tags: kev, has-exploit, exploited-in-wild.
  signalTags  String[]
  rawPayload  Json?
  fetchedAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  verdictCaches SecurityEvaluationThreatVerdictCache[]

  @@unique([source, externalId])
  @@index([category])
  @@index([severity])
  @@index([publishedAt])
  // Match-pipeline keyset scan: WHERE fetchedAt >= since ORDER BY fetchedAt DESC, id.
  @@index([fetchedAt])
  @@schema("module/security-evaluation")
}

/// Verdict kinds recorded per (knowledge item, scope) in the INTEL verdict
/// cache (formerly "negative cache", ADR-045). The cache now stores both
/// LLM "not-relevant" verdicts (TTL 7 days by default, filtered out of
/// subsequent pipelines) and hard-recall "hard-hit" verdicts (audit-only,
/// always re-computed per run).
enum SecurityEvaluationVerdictKind {
  notRelevant @map("not-relevant")
  hardHit     @map("hard-hit")

  @@schema("module/security-evaluation")
}

/// Verdict cache for INTEL matching (ADR-045): every judgment outcome
/// that is stable over short runs is recorded per (knowledge item, scope).
///
/// - `not-relevant`: LLM re-ranker said this knowledge item has no bearing
///   on this scope. Expires after the declared ttlDays (ADR-033).
///   Subsequent runs skip the pair entirely — no re-check.
/// - `hard-hit`: hard-recall matched this item to this scope's entities.
///   Audit only — the pair still re-enters the pipeline each run because
///   the hard-match result depends on the entity set, which is dynamic.
///
/// A cache row is not knowledge: it has its own lifecycle (expires
/// independently of the knowledge row), which is why it lives in its own
/// table instead of a JSON column on the knowledge item. The composite
/// unique key turns concurrent scope judgments into an upsert.
model SecurityEvaluationThreatVerdictCache {
  id              String                              @id @default(uuid()) @db.Uuid
  knowledgeItemId  String                             @db.Uuid
  // Host-defined scope identifier, stored verbatim: "scopeType:scopeId".
  scopeKey        String                             @db.VarChar(512)
  verdict         SecurityEvaluationVerdictKind      @default(notRelevant)
  reason          String?                            @db.Text           // LLM reason for not-relevant; null on hard-hit
  matchedEntity   String?                            @db.VarChar(512)   // Entity string that matched on hard-hit; null otherwise
  // Content address of the exact re-rank request that produced this verdict
  // (model id + system prompt + item payload + sampling options). A read-side
  // mismatch means the judgment input changed and the verdict must be re-judged.
  inputSignature  String?                            @db.VarChar(64)
  updatedAt       DateTime                           @updatedAt

  knowledgeItem SecurityEvaluationThreatKnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@unique([knowledgeItemId, scopeKey])
  @@index([scopeKey])
  @@index([verdict, updatedAt])
  @@schema("module/security-evaluation")
}

/// Bipolar verdict cache for CODE_SCAN LLM judgment (ADR-054): positive AND
/// negative per-file verdicts are cached, keyed by the full judgment identity
/// (subject, criterion, path, content hash, model, prompt version, ruleset
/// version). Unlike the INTEL cache — where only "not-relevant" is reusable
/// because a feed item is one-shot — a source file persists across runs, so a
/// positive verdict is reusable too; replaying it keeps finding identities
/// deterministic across runs and shields files skipped by a later run's
/// budget from the absent-finding reaper.
///
/// `unavailable` verdicts are never written (ADR-045 bottom line). Rows older
/// than the declared codeScanVerdictCacheTtlDays are misses: content or
/// version changes already invalidate the key, so the TTL only forces a
/// long-unchanged file to be re-judged against model drift.
///
/// `findings` holds the structured finding entries the cached call produced
/// for this one criterion (usually an empty array) — one row per criterion of
/// the ruleset, all sharing the call's `inputSignature`.
model SecurityEvaluationCodeScanVerdictCache {
  id             String   @id @default(uuid()) @db.Uuid
  // EvaluationSubject.id in "module/evaluation"; scalar, no FK
  subjectId      String   @db.Uuid
  criterionKey   String   @db.VarChar(128)
  // Repository-root relative path of the judged file.
  path           String   @db.VarChar(1024)
  // SHA-256 of the full file content the verdict describes.
  contentHash    String   @db.VarChar(64)
  modelId        String   @db.VarChar(255)
  // LLM ConnectionScope.id that produced this verdict; nullable for legacy
  // rows written before the connectionId column existed. Two connections that
  // happen to share the same modelId still cache separately.
  connectionId   String?  @db.Uuid
  // SHA-256 of the system prompt bytes; editing the prompt invalidates rows.
  promptVersion  String   @db.VarChar(64)
  ruleSetVersion String   @db.VarChar(32)
  // Finding entries of this criterion from the cached call (JSON array).
  findings       Json     @db.JsonB
  // Content address of the exact request that produced this verdict.
  inputSignature String?  @db.VarChar(64)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([subjectId, criterionKey, path, contentHash, modelId, connectionId, promptVersion, ruleSetVersion], name: "codeScanVerdictIdentity")
  @@index([subjectId, updatedAt])
  @@schema("module/security-evaluation")
}

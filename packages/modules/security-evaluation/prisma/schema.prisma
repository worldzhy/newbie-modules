// Prisma schema fragment for the security-evaluation module (ADR-022).
// This file is managed by @devbie/newbie-cli, which assembles it into the
// consumer Prisma tree on `newbie modules apply`.
//
// The run, result, criteria and finding tables belong to the evaluation
// skeleton (`module/evaluation`, ADR-020). This module owns the subject-scoped
// knowledge, the web-origin ownership-verification record, the repository and
// aws-account material rows, and the code-scan caches. `subjectId` is a plain
// scalar with no relation, because foreign keys never cross schema boundaries.
// Identity is the subject coordinate `(subjectType, kind, subjectKey)`
// (ADR-068 D7, ADR-069); material rows hold only what is specific to their kind
// and are keyed by the same natural coordinate (ADR-070 D1, D2).

// !! ------------------------------------------------------------ //
// !!             [Module] Security Evaluation models              //
// !! ------------------------------------------------------------ //
// * SecurityEvaluationWebOrigin                                   //
// * SecurityEvaluationRepository                                  //
// * SecurityEvaluationAwsAccount                                  //
// * SecurityEvaluationAwsConfigKnowledgeItem                      //
// * SecurityEvaluationNpmPackageKnowledgeItem                     //
// !! ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

/// Ownership-verification record of a web-origin subject (ADR-066, ADR-044).
///
/// One row per subject. The subject carries the identity (`subjectKey` is the
/// normalized origin, `displayName` the label) and provenance stays in the host
/// (ADR-068 D8); this table owns only what is specific to a web origin: where it
/// runs, which path roles criteria can target, and whether the deployment still
/// controls the origin.
///
/// Only active, `VERIFIED` subjects are submitted for evaluation, fetched lazily
/// through `listActiveVerified`, so the module needs no scheduler. Consecutive
/// failures that reach the configured threshold move the row to `FAILED`, which
/// stops evaluation of a domain that may have changed hands.
model SecurityEvaluationWebOrigin {
  id                   String    @id @default(uuid()) @db.Uuid
  // EvaluationSubject.id in "module/evaluation"; scalar, no FK
  subjectId            String    @unique @db.Uuid
  // Free-form deployment slot chosen by the host ("production", "staging"...).
  environment          String    @db.VarChar(32)
  // Path role to relative path, e.g. { "auth.login": "/login" }. A criterion
  // depending on a dropped role reports "target not configured".
  targetPaths          Json      @default("{}") @db.JsonB
  // PENDING | VERIFIED | FAILED | REVOKED.
  verificationStatus   String    @default("PENDING") @db.VarChar(16)
  verificationToken    String    @db.VarChar(64)
  // DNS_TXT | WELL_KNOWN; null until the host requests a verification method.
  verificationMethod   String?   @db.VarChar(16)
  // Consecutive failed re-verifications; reset on success.
  verificationFailureCount Int  @default(0)
  verifiedAt           DateTime?
  lastVerifiedAt       DateTime?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([verificationStatus, isActive])
  @@schema("module/security-evaluation")
}

/// Repository material of a repository subject (ADR-070 D1).
///
/// The host keeps its own repository record as the source of truth, since
/// application provisioning references it; this row is the evaluation-side copy
/// of the coordinate, so evidence collection learns the code host and the
/// `namespace/name` a subject names without reading a host table. Rows are
/// written by ingest only and are keyed by the natural coordinate, never by a
/// host id, so several projects naming the same repository share one row.
model SecurityEvaluationRepository {
  id        String   @id @default(uuid()) @db.Uuid
  // EvaluationSubject.id in "module/evaluation"; scalar, no FK
  subjectId String   @unique @db.Uuid
  provider  String   @db.VarChar(32)
  // Vendor-neutral first segment of the coordinate: GitHub owner, Bitbucket
  // workspace, and so on. Lowercased; the subject display name keeps the
  // original case.
  namespace String   @db.VarChar(255)
  name      String   @db.VarChar(255)
  url       String?  @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, namespace, name])
  @@schema("module/security-evaluation")
}

/// AWS account material of an aws-account subject (ADR-070 D1).
///
/// The account id is the natural key, so an existing cross-account binding can
/// be recreated without changing it. Credentials stay a host concern: the
/// opaque `credentialRef` lives on the subject, never here.
model SecurityEvaluationAwsAccount {
  id            String   @id @default(uuid()) @db.Uuid
  // EvaluationSubject.id in "module/evaluation"; scalar, no FK
  subjectId     String   @unique @db.Uuid
  accountId     String   @unique @db.VarChar(12)
  defaultRegion String?  @db.VarChar(32)
  regions       String[]
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@schema("module/security-evaluation")
}

/// A current-state AWS configuration knowledge item collected from a subject:
/// a password policy, an access key, a bucket's security posture, and so on.
/// Items are upserted on collection and never deleted here; history lives in the
/// archived run manifest, and a stale `observedAt` is how "not observed
/// recently" is expressed.
///
/// The KnowledgeItem suffix marks the knowledge family (collected or external
/// knowledge consumed by judgment), not schema isomorphism: this table is
/// subject-scoped, while SecurityEvaluationThreatKnowledgeItem is world-scoped
/// (ADR-037 D9.1).
model SecurityEvaluationAwsConfigKnowledgeItem {
  id         String   @id @default(uuid()) @db.Uuid
  // EvaluationSubject.id in "module/evaluation"; scalar, no FK
  subjectId  String   @db.Uuid
  type       String   @db.VarChar(64) // "aws.iam.account-password-policy" | ...
  key        String   @db.VarChar(512) // stable identity within the type
  value      Json?    @db.JsonB // small intrinsic values: region, mfaEnabled...
  observedAt DateTime

  @@unique([subjectId, type, key])
  @@index([subjectId, type])
  @@schema("module/security-evaluation")
}

/// A current-state npm package knowledge item collected from a repository
/// subject: the package installed at a version. Same lifecycle and family
/// semantics as SecurityEvaluationAwsConfigKnowledgeItem.
model SecurityEvaluationNpmPackageKnowledgeItem {
  id         String   @id @default(uuid()) @db.Uuid
  // EvaluationSubject.id in "module/evaluation"; scalar, no FK
  subjectId  String   @db.Uuid
  type       String   @db.VarChar(64) // "npm.package"
  key        String   @db.VarChar(512) // "npm:lodash@4.17.20"
  value      Json?    @db.JsonB // small intrinsic values: version, isDev, ecosystem...
  observedAt DateTime

  @@unique([subjectId, type, key])
  @@index([subjectId, type])
  @@schema("module/security-evaluation")
}

// !! ------------------------------------------------------------ //
// !!            [Module] Security Evaluation Knowledge            //
// !! ------------------------------------------------------------ //
// * SecurityEvaluationThreatKnowledgeItem                         //
// * SecurityEvaluationThreatVerdictKind (enum)                    //
// * SecurityEvaluationThreatVerdictCache                          //
// * SecurityEvaluationCodeScanVerdictCache                        //
// * SecurityEvaluationCodeScanFileExcerpt                         //
// !! ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

/// One piece of external threat intelligence (ADR-039), deduplicated by (feed,
/// externalId). Re-fetching an existing item refreshes `rawPayload` and bumps
/// `lastSeenAt`; `firstSeenAt` is never rewritten, so the evidence window keeps
/// selecting an item by its original collection time.
///
/// World-scoped: unlike the asset-scoped knowledge tables above, a threat item
/// belongs to no asset. It exists once per feed and is matched against every
/// asset's knowledge during judgment.
model SecurityEvaluationThreatKnowledgeItem {
  id          String   @id @default(uuid()) @db.Uuid
  feed        String   @db.VarChar(50)
  category    String   @db.VarChar(30)
  // Stable identifier within the feed: CVE ID, ecosystem+package,
  // vendor+event-id, or a title fingerprint.
  externalId  String   @db.VarChar(512)
  title       String   @db.VarChar(1024)
  summary     String?  @db.Text
  url         String?  @db.VarChar(1024)
  publishedAt DateTime?
  severity    String   @default("info") @db.VarChar(15)
  // Signal tags: kev, has-exploit, exploited-in-wild.
  signalTags  String[]
  rawPayload  Json?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  verdictCaches SecurityEvaluationThreatVerdictCache[]

  @@unique([feed, externalId])
  @@index([category])
  @@index([severity])
  @@index([publishedAt])
  // Evidence window: WHERE firstSeenAt >= since ORDER BY firstSeenAt DESC, id.
  @@index([firstSeenAt])
  @@schema("module/security-evaluation")
}

/// Verdict kinds recorded per (knowledge item, scope) in the INTEL verdict
/// cache (ADR-045). The cache stores two kinds: LLM "not-relevant" verdicts
/// (TTL `ttlDays`, skipped by subsequent pipelines) and hard-recall "hard-hit"
/// verdicts (audit only, re-computed on every run).
enum SecurityEvaluationThreatVerdictKind {
  notRelevant @map("not-relevant")
  hardHit     @map("hard-hit")

  @@schema("module/security-evaluation")
}

/// Verdict cache for INTEL matching (ADR-045): every judgment outcome that is
/// stable over short runs is recorded per (knowledge item, scope).
///
/// - `not-relevant`: the LLM re-ranker found this knowledge item irrelevant to
///   this scope. The pair is skipped only while the row is younger than the
///   declared `ttlDays` (ADR-033).
/// - `hard-hit`: hard-recall matched this item to entities of this scope. Audit
///   only: the pair re-enters the pipeline each run because a hard match depends
///   on the entity set, which is dynamic.
///
/// A cache row is not knowledge, and its lifecycle is independent of the
/// knowledge row, which is why it lives in its own table instead of a JSON
/// column on the knowledge item. The composite unique key turns concurrent scope
/// judgments into an upsert.
model SecurityEvaluationThreatVerdictCache {
  id              String                              @id @default(uuid()) @db.Uuid
  knowledgeItemId  String                             @db.Uuid
  // Cache scope, the subject identity columns verbatim (ADR-058, ADR-068 D6).
  subjectKind     String                             @db.VarChar(64)
  subjectKey      String                             @db.VarChar(255)
  verdict         SecurityEvaluationThreatVerdictKind @default(notRelevant)
  reason          String?                            @db.Text           // LLM reason for not-relevant; null on hard-hit
  matchedEntity   String?                            @db.VarChar(512)   // Entity string that matched on hard-hit; null otherwise
  // Content address of the exact re-rank request that produced this verdict
  // (model id + system prompt + item payload + sampling options). A read-side
  // mismatch means the judgment input changed and the verdict must be re-judged.
  inputSignature  String?                            @db.VarChar(64)
  updatedAt       DateTime                           @updatedAt

  knowledgeItem SecurityEvaluationThreatKnowledgeItem @relation(fields: [knowledgeItemId], references: [id], onDelete: Cascade)

  @@unique([knowledgeItemId, subjectKind, subjectKey])
  @@index([subjectKind, subjectKey])
  @@index([verdict, updatedAt])
  @@schema("module/security-evaluation")
}

/// Bipolar verdict cache for CODE_SCAN LLM judgment (ADR-054): positive and
/// negative per-file verdicts are both cached, keyed by the full judgment
/// identity (subject, criterion, path, content hash, model, connection, prompt
/// version, rule-set version). The INTEL cache reuses only "not-relevant"
/// verdicts because a feed item is one-shot; a source file persists across runs,
/// so a positive verdict is reusable too. Replaying it keeps finding identities
/// deterministic across runs and shields files skipped by a later run's budget
/// from the absent-finding reaper.
///
/// `unavailable` verdicts are never written (ADR-045). Rows older than the
/// declared `codeScanVerdictCacheTtlDays` are misses: content or version changes
/// already invalidate the key, so the TTL only forces a long-unchanged file to
/// be re-judged against model drift.
///
/// `cachedFindings` holds the structured finding entries the cached call produced
/// for this one criterion (usually an empty array); every criterion of the
/// ruleset gets its own row, and all rows of a call share its `inputSignature`.
model SecurityEvaluationCodeScanVerdictCache {
  id             String   @id @default(uuid()) @db.Uuid
  // EvaluationSubject.id in "module/evaluation"; scalar, no FK
  subjectId      String   @db.Uuid
  criterionKey   String   @db.VarChar(128)
  // Repository-root relative path of the judged file.
  path           String   @db.VarChar(1024)
  // SHA-256 of the full file content the verdict describes.
  contentHash    String   @db.VarChar(64)
  modelId        String   @db.VarChar(255)
  // LLM ConnectionScope.id that produced this verdict; null on rows written
  // before this column existed. Two connections sharing one modelId still cache
  // separately.
  connectionId   String?  @db.Uuid
  // SHA-256 of the system prompt bytes; editing the prompt invalidates rows.
  promptVersion  String   @db.VarChar(64)
  ruleSetVersionLabel String @db.VarChar(32)
  // Findings of this criterion from the cached call (JSON array; usually empty).
  cachedFindings Json     @db.JsonB
  // Content address of the exact request that produced this verdict.
  inputSignature String?  @db.VarChar(64)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([subjectId, criterionKey, path, contentHash, modelId, connectionId, promptVersion, ruleSetVersionLabel], name: "codeScanVerdictIdentity")
  @@index([subjectId, updatedAt])
  @@schema("module/security-evaluation")
}

/// Truncated source excerpt of one scanned file: the material the CODE_SCAN LLM
/// actually judged (ADR-054 D7). It lives outside the archived result manifest,
/// which keeps only the content hash and the truncated flag, so the immutable
/// result never accumulates source code.
///
/// Content-addressed by (subjectId, contentHash): rescanning an unchanged file
/// writes nothing, and every run whose manifest carries that hash reads the same
/// excerpt. `updatedAt` is the retention clock: rows older than
/// `SECURITY_EVALUATION_CODE_SCAN_EXCERPT_RETENTION_DAYS` are physically deleted
/// by the retention service, after which the finding detail read falls back to
/// the hash and the truncated flag.
model SecurityEvaluationCodeScanFileExcerpt {
  id          String   @id @default(uuid()) @db.Uuid
  // EvaluationSubject.id in "module/evaluation"; scalar, no FK
  subjectId   String   @db.Uuid
  // SHA-256 of the full file content the excerpt was cut from.
  contentHash String   @db.VarChar(64)
  // The truncated prefix the LLM call saw.
  excerpt     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([subjectId, contentHash])
  @@index([updatedAt])
  @@schema("module/security-evaluation")
}

// !!               [Module] Threat Intelligence models                  //
// !! ------------------------------------------------------------ //
// * ThreatIntelligenceItem                                                    //
// * ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ //

// A single piece of external threat intelligence, deduplicated by
// (source, externalId). One row per unique intel item; re-fetching the
// same item updates rawPayload / fetchedAt and bumps lastSeenAt.
//
// Project matching is intentionally NOT modelled here: this module is the
// platform-level collection layer only. A host that wants to relate items
// to its own projects owns that table and that logic.
model ThreatIntelligenceItem {
  id          String   @id @default(uuid()) @db.Uuid
  source      String   @db.VarChar(50)
  category    String   @db.VarChar(30)
  // Stable identifier within the source: CVE ID, ecosystem+package,
  // vendor+event-id, or a title fingerprint. Together with `source` it
  // forms the deduplication key.
  externalId  String   @db.VarChar(512)
  title       String   @db.VarChar(1024)
  summary     String?  @db.Text
  url         String?  @db.VarChar(1024)
  publishedAt DateTime?
  severity    String   @default("info") @db.VarChar(15)
  // Signal tags: kev, has-exploit, exploited-in-wild.
  signalTags  String[]
  rawPayload  Json?
  fetchedAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([source, externalId])
  @@index([category])
  @@index([severity])
  @@index([publishedAt])
  @@schema("module/threat-intelligence")
}

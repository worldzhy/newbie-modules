{
  "key": "aws-sqs",
  "layer": "infrastructure",
  "module": {
    "file": "aws-sqs.module",
    "className": "AwsSqsModule"
  },
  "moduleDependencies": ["aws-identity"],
  "config-service": {
    "aws-sqs": {
      "region": "process.env.AWS_SQS_REGION",
      "queueUrl": "process.env.AWS_SQS_QUEUE_URL"
    }
  },
  "env": {
    "AWS_SQS_REGION": { "example": "us-east-1" },
    "AWS_SQS_QUEUE_URL": ""
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "latest",
    "validator": "latest"
  },
  "devDependencies": {
    "@types/validator": "latest"
  }
}

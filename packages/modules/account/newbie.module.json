{
  "key": "account",
  "layer": "capability",
  "module": {
    "file": "account.module",
    "className": "AccountModule"
  },
  "schema": "prisma/schema.prisma",
  "moduleDependencies": ["audit", "aws-ses", "aws-sms", "security"],
  "config-service": {
    "account": {
      "cache": {
        "geolocationLruSize": "int(process.env.CACHE_GEOLOCATION_LRU_SIZE, 100)",
        "apiKeyLruSize": "int(process.env.CACHE_APIKEY_LRU_SIZE, 100)"
      },
      "verificationCode": {
        "timeoutMinutes": 10,
        "resendMinutes": 1,
        "maxAttempts": 5
      },
      "approvedSubnet": {
        "hmacSecret": "process.env.ACCOUNT_APPROVED_SUBNET_HMAC_SECRET"
      },
      "googleAuth": {
        "clientId": "process.env.GOOGLE_AUTH_CLIENT_ID || 'your-client-id'",
        "clientSecret": "process.env.GOOGLE_AUTH_CLIENT_SECRET || 'your-client-secret'",
        "callbackURL": "process.env.GOOGLE_AUTH_CALLBACK_URL || 'your-callback-url'"
      },
      "wechat": {
        "appId": "process.env.WECHAT_APP_ID || 'your-app-id'",
        "appSecret": "process.env.WECHAT_APP_SECRET || 'your-app-secret'"
      },
      "larkAuth": {
        "appId": "process.env.LARK_APP_ID",
        "appSecret": "process.env.LARK_APP_SECRET",
        "callbackURL": "process.env.LARK_AUTH_CALLBACK_URL"
      }
    }
  },
  "env": {
    "ACCOUNT_APPROVED_SUBNET_HMAC_SECRET": "",
    "CACHE_GEOLOCATION_LRU_SIZE": "",
    "CACHE_APIKEY_LRU_SIZE": "",
    "GOOGLE_AUTH_CLIENT_ID": "",
    "GOOGLE_AUTH_CLIENT_SECRET": "",
    "GOOGLE_AUTH_CALLBACK_URL": "",
    "WECHAT_APP_ID": "",
    "WECHAT_APP_SECRET": "",
    "LARK_AUTH_CALLBACK_URL": ""
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@nestjs/passport": "latest",
    "geolite2-redist": "latest",
    "ioredis": "latest",
    "ip-anonymize": "latest",
    "lru-cache": "latest",
    "maxmind": "latest",
    "otplib": "latest",
    "passport": "latest",
    "passport-custom": "latest",
    "passport-google-oauth20": "latest",
    "passport-local": "latest",
    "qrcode": "latest",
    "randomcolor": "latest",
    "rate-limiter-flexible": "latest",
    "ua-parser-js": "latest",
    "validator": "latest"
  },
  "devDependencies": {
    "@types/passport-google-oauth20": "latest",
    "@types/passport-local": "latest",
    "@types/qrcode": "latest",
    "@types/validator": "latest"
  }
}

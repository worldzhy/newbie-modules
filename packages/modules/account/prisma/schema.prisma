// ! ------------------------------------------------------------ //
// !                [Module] Account models                 //
// ! ------------------------------------------------------------ //
// * User                                                         //
// * Email                                                        //
// * Permission                                                   //
// * VerificationCode                                             //
// * Session                                                      //
// * ApprovedSubnet                                               //
// * ApiKey                                                       //
// * ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

model User {
  // [1] The 'User' and 'VerificationCode' models are both used for logging in.
  // [2] The 'User' is designed for long-term use and the 'VerificationCode' is designed for short-term use.
  // [3] Actually, the 'User' model should be named 'UserPassword' and the 'VerificationCode' should be named 'UserVerificationCode'.
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkLocationOnLogin Boolean          @default(false)
  status               UserStatus       @default(ACTIVE)
  email                String?          @unique
  phone                String?          @unique
  password             String? // automatic hashing
  name                 String?
  firstName            String?
  middleName           String?
  lastName             String?
  dateOfBirth          DateTime?        @db.Date
  gender               UserGender?
  avatarFileId         String?
  uiAvatarsUrl         String?
  timezone             String           @default("America/Los_Angeles")
  twoFactorMethod      MfaMethod        @default(NONE)
  twoFactorPhone       String?
  twoFactorSecret      String?
  // Pending TOTP secret awaiting confirmation via enable(). The active
  // twoFactorSecret is only overwritten inside enable() after a valid code
  // is presented against this pending value (ADR-033).
  pendingTwoFactorSecret String?
  lastLoginAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  apiKeys              ApiKey[]
  approvedSubnets      ApprovedSubnet[]
  emails               Email[]
  sessions             Session[]
  roles                UserRole[]
  externalIdentities   AccountExternalIdentity[]

  // WeChat mini-program fields
  wechatOpenId     String? @unique // Unique WeChat user identifier
  wechatUnionId    String? // Unique WeChat Open Platform identifier
  wechatSessionKey String? // WeChat session key

  // Feishu/Lark OAuth fields. larkOpenId is app-scoped and the primary SSO
  // handle; it must share the same Feishu app as the bot so a webhook open_id
  // resolves to the same account.
  larkOpenId  String? @unique
  larkUnionId String?

  @@schema("module/account")
}

model Email {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid

  @@index([userId])
  @@schema("module/account")
}

model Permission {
  // Permission of Resource
  id            Int              @id @default(autoincrement())
  action        PermissionAction
  resource      String
  trustedUserId String?          @db.Uuid
  roleId        Int?
  role          Role?            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([roleId])
  @@index([trustedUserId])
  @@schema("module/account")
}

model Role {
  id                      Int                    @id @default(autoincrement())
  name                    String                 @unique
  isBuiltin               Boolean                @default(false)
  description             String?
  permissions             Permission[]
  users                   UserRole[]
  rolePermissionGroups    RolePermissionGroup[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@schema("module/account")
}

model UserRole {
  userId String @db.Uuid
  roleId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@schema("module/account")
}

model PermissionGroup {
  id            Int                    @id @default(autoincrement())
  name          String                 @unique
  description   String?
  routePath     String
  navGroup      String
  navLabel      String
  navIcon       String?
  isBuiltin     Boolean                @default(true)
  permissions   PermissionGroupPermission[]
  roles         RolePermissionGroup[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@schema("module/account")
}

model PermissionGroupPermission {
  id                 Int             @id @default(autoincrement())
  permissionGroupId  Int
  permissionGroup    PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)
  action             PermissionAction
  resource           String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([permissionGroupId, action, resource])
  @@schema("module/account")
}

model RolePermissionGroup {
  roleId             Int
  permissionGroupId  Int
  role               Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionGroup    PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionGroupId])
  @@schema("module/account")
}

model VerificationCode {
  id        Int                    @id @default(autoincrement())
  email     String?
  phone     String?
  code      String
  status    VerificationCodeStatus
  use       VerificationCodeUse
  expiredAt DateTime
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([email, use])
  @@index([phone, use])
  @@schema("module/account")
}

model Session {
  id              Int      @id @default(autoincrement())
  accessToken     String   @unique
  // SHA-256 hex of the current refresh token. The plaintext is never stored
  // (ADR-034); refresh matches by hash and rotates with a CAS update.
  refreshTokenHash        String   @unique
  // Hash of the token rotated out by the most recent refresh. Used to detect
  // idempotent retries of the same rotation within the short reuse window.
  previousRefreshTokenHash String?  @unique
  // Timestamp of the last successful rotation; bounds the idempotency window.
  rotatedAt               DateTime?
  // Plaintext of the freshly minted refresh token, retained only for the
  // idempotency window so a retried refresh returns the same token pair.
  refreshTokenNext        String?
  ipAddress       String
  userAgent       String?
  city            String?
  region          String?
  timezone        String?
  countryCode     String?
  browser         String?
  operatingSystem String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String   @db.Uuid

  // @unique already creates indexes for accessToken and the hash columns.
  @@index([userId])
  @@schema("module/account")
}

model ApprovedSubnet {
  id          Int      @id @default(autoincrement())
  subnet      String
  // Deterministic keyed hash enabling an indexed, constant-time subnet
  // lookup. Nullable: rows created before this column are kept as-is and
  // matched through the legacy bcrypt `subnet` fallback.
  subnetHmac  String?
  city        String?
  region      String?
  timezone    String?
  countryCode String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @db.Uuid

  // One row per (user, subnet): the deterministic HMAC doubles as a dedupe key.
  @@unique([userId, subnetHmac])
  @@index([userId])
  @@schema("module/account")
}

model ApiKey {
  id                   Int        @id @default(autoincrement())
  key                  String     @unique
  secret               String
  description          String?
  ipRestrictions       Json?
  referrerRestrictions Json?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String     @db.Uuid
  organizationId       String?    @db.Uuid

  @@index([userId])
  @@schema("module/account")
}

/// External platform identity used for evidence attribution (ADR-029 in
/// nightwatch-backend). The platform account id is the primary attribution
/// key — never the display name or email. `platform` is an uppercase tag
/// such as "GITHUB" or "BITBUCKET".
model AccountExternalIdentity {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  platform          String   @db.VarChar(32)
  externalAccountId String   @db.VarChar(128)
  displayName       String?  @db.VarChar(255)
  linkedAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, externalAccountId])
  @@index([userId])
  @@schema("module/account")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL

  @@schema("module/account")
}

enum UserGender {
  MALE
  FEMALE
  NONBINARY
  UNKNOWN

  @@schema("module/account")
}

enum MfaMethod {
  NONE
  SMS
  TOTP
  EMAIL

  @@schema("module/account")
}

enum PermissionAction {
  Manage
  List
  Get
  Create
  Update
  Delete

  @@schema("module/account")
}

enum VerificationCodeStatus {
  ACTIVE
  INACTIVE

  @@schema("module/account")
}

enum VerificationCodeUse {
  UNKNOWN
  // For generating JWT.
  LOGIN_BY_EMAIL
  LOGIN_BY_PHONE
  // For closing and recovering account.
  CLOSE_ACCOUNT_BY_EMAIL
  CLOSE_ACCOUNT_BY_PHONE
  RECOVER_ACCOUNT_BY_EMAIL
  RECOVER_ACCOUNT_BY_PHONE
  // For other operations
  BIND_EMAIL
  BIND_PHONE
  CHANGE_PASSWORD
  RESET_PASSWORD

  @@schema("module/account")
}

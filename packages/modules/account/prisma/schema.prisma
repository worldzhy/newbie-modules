// !! ------------------------------------------------------------ //
// !!                   [Module] Account models                    //
// !! ------------------------------------------------------------ //
// * User                                                          //
// * Email                                                         //
// * Permission                                                    //
// * Role                                                          //
// * UserRole                                                      //
// * PermissionGroup                                               //
// * PermissionGroupPermission                                     //
// * RolePermissionGroup                                           //
// * VerificationCode                                              //
// * Session                                                       //
// * ApprovedSubnet                                                //
// * ApiKey                                                        //
// * AccountExternalIdentity                                       //
// * UserStatus (enum)                                             //
// * UserGender (enum)                                             //
// * UserTheme (enum)                                              //
// * MfaMethod (enum)                                              //
// * NavPlacement (enum)                                           //
// * PermissionAction (enum)                                       //
// * VerificationCodeStatus (enum)                                 //
// * VerificationCodeUse (enum)                                    //
// !! ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

model User {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkLocationOnLogin Boolean          @default(false)
  status               UserStatus       @default(ACTIVE)
  email                String?          @unique
  phone                String?          @unique
  password             String? // hashed by the Prisma extension on create/update
  name                 String?
  firstName            String?
  middleName           String?
  lastName             String?
  dateOfBirth          DateTime?        @db.Date
  gender               UserGender?
  avatarFileId         String?
  uiAvatarsUrl         String?
  // Display preferences are nullable with no default: the framework does not
  // choose a language, theme or timezone for the user. Each host falls back at
  // its own boundary (ADR-049).
  language             String? // BCP-47 tag, e.g. "en" or "zh"
  theme                UserTheme?
  timezone             String?
  twoFactorMethod      MfaMethod        @default(NONE)
  twoFactorPhone       String?
  // AES-256-GCM ciphertext produced by TokenService.sealTotpSecret(), never
  // the raw base32 secret (R33-04). A database read alone cannot mint codes.
  twoFactorSecret      String?
  // Pending TOTP secret awaiting confirmation via enable(). The active
  // twoFactorSecret is only overwritten inside enable() after a valid code
  // is presented against this pending value (ADR-033).
  pendingTwoFactorSecret String?
  lastLoginAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  apiKeys              ApiKey[]
  approvedSubnets      ApprovedSubnet[]
  emails               Email[]
  sessions             Session[]
  roles                UserRole[]
  externalIdentities   AccountExternalIdentity[]

  // WeChat mini-program identity
  wechatOpenId     String? @unique // per-app user id; differs across apps
  wechatUnionId    String? // Open Platform UnionID shared across apps
  wechatSessionKey String? // session key for decrypting WeChat payloads

  // Feishu/Lark OAuth identity. larkOpenId is app-scoped and is the primary
  // SSO handle; it must come from the same Feishu app as the bot so a webhook
  // open_id resolves to the same account.
  larkOpenId  String? @unique
  larkUnionId String?

  @@schema("module/account")
}

model Email {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid

  @@index([userId])
  @@schema("module/account")
}

model Permission {
  // One action on one resource, granted through a role or directly to a
  // trusted user.
  id            Int              @id @default(autoincrement())
  action        PermissionAction
  resource      String
  trustedUserId String?          @db.Uuid
  roleId        Int?
  role          Role?            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([roleId])
  @@index([trustedUserId])
  @@schema("module/account")
}

model Role {
  id                      Int                    @id @default(autoincrement())
  name                    String                 @unique
  isBuiltin               Boolean                @default(false)
  description             String?
  permissions             Permission[]
  users                   UserRole[]
  rolePermissionGroups    RolePermissionGroup[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@schema("module/account")
}

model UserRole {
  userId String @db.Uuid
  roleId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@schema("module/account")
}

model PermissionGroup {
  id            Int                    @id @default(autoincrement())
  name          String                 @unique
  description   String?
  routePath     String
  // Where the group surfaces in the application chrome. Every header entry has
  // the same standing, so placement only decides whether it renders there.
  navPlacement  NavPlacement           @default(NONE)
  // Position among header entries (1-based, ascending). Gaps are allowed; the
  // frontend renders the lowest N directly and folds the rest into one overflow
  // menu. The overflow threshold is a presentation constant, not stored here.
  navOrder      Int                    @default(0)
  navLabel      String
  navIcon       String?
  isBuiltin     Boolean                @default(true)
  permissions   PermissionGroupPermission[]
  roles         RolePermissionGroup[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@schema("module/account")
}

model PermissionGroupPermission {
  id                 Int             @id @default(autoincrement())
  permissionGroupId  Int
  permissionGroup    PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)
  action             PermissionAction
  resource           String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([permissionGroupId, action, resource])
  @@schema("module/account")
}

model RolePermissionGroup {
  roleId             Int
  permissionGroupId  Int
  role               Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionGroup    PermissionGroup @relation(fields: [permissionGroupId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionGroupId])
  @@schema("module/account")
}

model VerificationCode {
  id        Int                    @id @default(autoincrement())
  email     String?
  phone     String?
  code      String
  status    VerificationCodeStatus
  use       VerificationCodeUse
  expiredAt DateTime
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([email, use])
  @@index([phone, use])
  @@schema("module/account")
}

model Session {
  id              Int      @id @default(autoincrement())
  // No access token is stored. The access JWT carries this row's id as `sid`
  // and authentication resolves the row by id (devbie ADR-051), so a row never
  // holds a usable bearer credential.
  // SHA-256 hex of the current refresh token. The plaintext is never stored
  // (nightwatch-backend ADR-034); refresh matches by hash and rotates with a
  // CAS update.
  refreshTokenHash        String   @unique
  // Hash of the token rotated out by the most recent refresh. Used to detect
  // idempotent retries of the same rotation within the short reuse window.
  previousRefreshTokenHash String?  @unique
  // Timestamp of the last successful rotation; bounds the idempotency window.
  rotatedAt               DateTime?
  // AES-256-GCM sealed form of the freshly minted refresh token, retained only
  // for the idempotency window so a retried refresh returns the same token
  // pair. Sealed at rest by TokenService, so a database read never yields a
  // usable credential (nightwatch-backend ADR-034, R20-11).
  refreshTokenNextSealed String?
  ipAddress       String
  userAgent       String?
  city            String?
  region          String?
  timezone        String?
  countryCode     String?
  browser         String?
  operatingSystem String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String   @db.Uuid

  // @unique already indexes the hash columns.
  @@index([userId])
  @@schema("module/account")
}

model ApprovedSubnet {
  id          Int      @id @default(autoincrement())
  subnet      String
  // Deterministic keyed hash enabling an indexed, constant-time subnet
  // lookup. Nullable: rows without it are matched through the bcrypt `subnet`
  // value.
  subnetHmac  String?
  city        String?
  region      String?
  timezone    String?
  countryCode String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @db.Uuid

  // Dedupe key: unique on (user, subnetHmac). NULL hmac values are not deduped
  // because Postgres treats NULLs as distinct.
  @@unique([userId, subnetHmac])
  @@index([userId])
  @@schema("module/account")
}

model ApiKey {
  id                   Int        @id @default(autoincrement())
  key                  String     @unique
  secret               String
  description          String?
  ipRestrictions       Json?
  referrerRestrictions Json?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String     @db.Uuid

  @@index([userId])
  @@schema("module/account")
}

/// One external platform identity per linked account, used for evidence
/// attribution (nightwatch-backend ADR-029). The platform account id is the
/// primary attribution key — never the display name or email. `platform` is an
/// uppercase tag such as "GITHUB" or "BITBUCKET".
model AccountExternalIdentity {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  platform          String   @db.VarChar(32)
  externalAccountId String   @db.VarChar(128)
  displayName       String?  @db.VarChar(255)
  linkedAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platform, externalAccountId])
  @@index([userId])
  @@schema("module/account")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL

  @@schema("module/account")
}

enum UserGender {
  MALE
  FEMALE
  NONBINARY
  UNKNOWN

  @@schema("module/account")
}

enum UserTheme {
  LIGHT
  DARK
  SYSTEM

  @@schema("module/account")
}

enum MfaMethod {
  NONE
  SMS
  TOTP
  EMAIL

  @@schema("module/account")
}

enum NavPlacement {
  HEADER_NAVIGATION
  NONE

  @@schema("module/account")
}

enum PermissionAction {
  List
  Get
  Create
  Update
  Delete

  @@schema("module/account")
}

enum VerificationCodeStatus {
  ACTIVE
  INACTIVE

  @@schema("module/account")
}

enum VerificationCodeUse {
  UNKNOWN
  // Login: the code is exchanged for a JWT.
  LOGIN_BY_EMAIL
  LOGIN_BY_PHONE
  // Close or recover the account.
  CLOSE_ACCOUNT_BY_EMAIL
  CLOSE_ACCOUNT_BY_PHONE
  RECOVER_ACCOUNT_BY_EMAIL
  RECOVER_ACCOUNT_BY_PHONE
  // Binding and password operations.
  BIND_EMAIL
  BIND_PHONE
  CHANGE_PASSWORD
  RESET_PASSWORD

  @@schema("module/account")
}

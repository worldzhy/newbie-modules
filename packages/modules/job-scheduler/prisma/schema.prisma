/// One job schedule: the job key and handler binding, when it runs (cronExpr +
/// timezone), the enabled flag, and the opaque payload passed to the handler.
/// Business modules declare defaults on startup (`createdVia="declaration"`);
/// the database row wins at runtime, so operators can pause a schedule, change
/// its cron expression, or trigger it manually. Only the name stays
/// declaration-owned and is re-synced on every startup.
model JobSchedule {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  name       String   @default("")
  handlerKey String
  cronExpr   String
  timezone   String   @default("Asia/Shanghai")
  isEnabled  Boolean  @default(true)
  payload    Json?
  createdVia String   @default("declaration")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  runs JobRun[]

  @@schema("module/job-scheduler")
}

/// One job-run record: trigger source, status, timing, duration, and error.
/// `status="skipped"` marks a run rejected by the reentry guard because the
/// previous run of the same schedule was still in progress.
model JobRun {
  id         Int       @id @default(autoincrement())
  scheduleId Int
  /// schedule | manual
  trigger    String
  /// running | success | failed | skipped
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  error      String?

  schedule JobSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, startedAt])
  @@schema("module/job-scheduler")
}

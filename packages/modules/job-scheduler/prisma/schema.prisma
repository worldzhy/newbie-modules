/// A schedule for one job: human-readable name, when it runs (cronExpr +
/// timezone), whether it is enabled, and the opaque payload passed to the job
/// handler. Business modules upsert defaults on startup
/// (`createdVia="declaration"`); the database row wins at runtime so operators
/// can pause a schedule, change its cron expression, or trigger it manually.
/// The name stays declaration-owned and is re-synced on every startup.
model JobSchedule {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  name       String   @default("")
  handlerKey String
  cronExpr   String
  timezone   String   @default("Asia/Shanghai")
  enabled    Boolean  @default(true)
  payload    Json?
  createdVia String   @default("declaration")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  runs JobRun[]

  @@schema("module/job-scheduler")
}

/// Execution history for one job run. `status="skipped"` records a reentry
/// guard rejection: the previous run of the same schedule was still in progress.
model JobRun {
  id         Int       @id @default(autoincrement())
  scheduleId Int
  /// schedule | manual
  trigger    String
  /// running | success | failed | skipped
  status     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?
  error      String?

  schedule JobSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId, startedAt])
  @@schema("module/job-scheduler")
}

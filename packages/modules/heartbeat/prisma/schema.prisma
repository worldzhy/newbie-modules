// !! ------------------------------------------------------------ //
// !!                  [Module] Heartbeat models                   //
// !! ------------------------------------------------------------ //
// * HeartbeatInstallation                                         //
// !! ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

// One row per running deployment endpoint enrolled with a heartbeat token: a
// newbie backend, a fewbie SSR process, or any other node service. The module
// is project-agnostic: platform-side grouping stays in opaque `externalRef` and
// is never parsed here.
//
// Liveness is derived from `lastSeenAt`, not stored: never seen (null), online
// (a ping within the last 90s, i.e. fewer than three missed 30s intervals), or
// offline. Only revocation is persisted explicitly.
model HeartbeatInstallation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Human-readable label set at enrollment, e.g. "nightwatch-prod".
  label String @db.VarChar(255)
  // SHA-256 hex of the heartbeat token. The plaintext token is returned once
  // at creation or rotation and never stored.
  tokenHash String @unique @db.VarChar(64)

  // Opaque platform-owned tag (e.g. "projectId/applicationId"); never parsed here.
  externalRef String? @db.VarChar(255)

  // Runtime facts self-reported on each ping; informational only.
  // Deployed application version, e.g. a git sha or semver.
  appVersion String? @db.VarChar(64)
  // Deployment environment, e.g. "prod".
  env String? @db.VarChar(64)
  // Instance identifier, e.g. an EC2 instance id or a hostname.
  instanceId String? @db.VarChar(128)

  firstSeenAt DateTime?
  lastSeenAt  DateTime?

  // Soft revocation: pings are rejected (401); rows are retained for audit.
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Host-side list views batch on `externalRef`; the offline monitor scans
  // `lastSeenAt` every minute.
  @@index([externalRef])
  @@index([lastSeenAt])
  @@schema("module/heartbeat")
}

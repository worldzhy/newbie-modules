// Self-reported runtime facts of a heartbeat installation. Identity and
// credential live in the shared `Installation` row (module/security, ADR-078);
// this table is 1:1 with it and keeps only what a ping reports.
//
// `installationId` is a plain scalar, not a relation: Prisma relations cannot
// cross schema boundaries in this repository, and the shared table must not
// depend on optional collector modules. 1:1 is guaranteed by the write path.
model HeartbeatAgentState {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  installationId String @unique @db.Uuid

  // Runtime facts self-reported on each ping; informational only.
  appVersion String? @db.VarChar(64)
  env String? @db.VarChar(64)
  instanceId String? @db.VarChar(128)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("module/heartbeat")
}

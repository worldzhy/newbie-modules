// Prisma schema fragment for the work-evaluation module (ADR-021, ADR-024).
// This file is managed by @devbie/newbie-cli and assembled into the consumer
// prisma tree on `newbie modules apply`.
//
// The run, result and criteria tables belong to the evaluation skeleton
// (`module/evaluation`, ADR-020); this feature owns only the collection-side
// tables. `ruleSetVersionId` is a plain scalar with no relation: foreign keys
// never cross schema boundaries.

// !! ------------------------------------------------------------ //
// !!               [Module] Work Evaluation models                //
// !! ------------------------------------------------------------ //
// * WorkEvaluationPeriodType (enum)                               //
// * WorkEvaluationPeriodStatus (enum)                             //
// * WorkEvaluationPeriod                                          //
// * WorkEvaluationHomeGround                                      //
// * WorkEvaluationWorkspace                                       //
// * WorkEvaluationSession                                         //
// * WorkEvaluationDeclaredDocument                                //
// * WorkEvaluationAgentState                                      //
// !! ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

enum WorkEvaluationPeriodType {
  COLLECTION
  REVIEW

  @@schema("module/work-evaluation")
}

enum WorkEvaluationPeriodStatus {
  UPCOMING
  ACTIVE
  CLOSED

  @@schema("module/work-evaluation")
}

/// One evaluation period: COLLECTION (monthly, evidence gathering) or REVIEW
/// (quarterly, decision-making). A period pins exactly one published criteria
/// version of the evaluation skeleton (subjectKind "developer"), so every
/// member inside it is judged against the same rules. The pin is a plain
/// scalar with no cross-schema relation.
model WorkEvaluationPeriod {
  id                String @id @default(uuid()) @db.Uuid
  // EvaluationRuleSetVersion.id in "module/evaluation"; scalar, no FK
  ruleSetVersionId String @db.Uuid
  phase             WorkEvaluationPeriodType
  periodStart       DateTime
  periodEnd         DateTime
  status            WorkEvaluationPeriodStatus @default(UPCOMING)

  homeGrounds WorkEvaluationHomeGround[]
  sessions    WorkEvaluationSession[]

  @@index([ruleSetVersionId])
  @@index([phase, periodStart])
  @@schema("module/work-evaluation")
}

/// One evaluatee's home-ground declaration for a period. Dual-circle model:
/// the criteria in `homeCriteria` are the specialty circle. There are no
/// weights; the declaration is context for the evaluation agent, never a
/// scoring input.
model WorkEvaluationHomeGround {
  id                 String @id @default(uuid()) @db.Uuid
  developerId    String @db.Uuid
  collectionPeriodId String @db.Uuid

  homeCriteria Json @db.JsonB // criterionKey[]
  declaredAt   DateTime @default(now())

  period WorkEvaluationPeriod @relation(fields: [collectionPeriodId], references: [id], onDelete: Cascade)

  @@unique([developerId, collectionPeriodId])
  @@index([developerId])
  @@schema("module/work-evaluation")
}

/// A workspace declared by the member and reported by the installation agent.
/// The declared set is an allowlist: a workspace is either declared, and in
/// scope, or absent from this table; there is no company/personal flag because
/// undeclared paths are never reported.
model WorkEvaluationWorkspace {
  id              String @id @default(uuid()) @db.Uuid
  developerId String @db.Uuid

  // IDE-side workspace identifier (stable across reports)
  workspaceKey String @db.VarChar(128)
  rootPath     String @db.VarChar(512)

  installationId String? @db.Uuid
  reportedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([developerId, workspaceKey])
  @@index([developerId])
  @@schema("module/work-evaluation")
}

/// Index row for one AI-agent coding session collected from a company
/// workspace. The transcript itself lives in ClickHouse
/// (`work_evaluation_session_messages`); this row carries what the evaluation
/// agent needs in order to decide whether to drill into the transcript.
model WorkEvaluationSession {
  id                 String  @id @default(uuid()) @db.Uuid
  developerId    String  @db.Uuid
  collectionPeriodId String? @db.Uuid

  // Installation-side session identifier (stable, e.g. the IDE transcript id)
  externalSessionId String @db.VarChar(128)
  workspaceKey      String @db.VarChar(128)
  modelId           String @default("") @db.VarChar(128)
  // Transcript origin: "claude" / "codex" (raw transcripts) or "trae-memory"
  // (the IDE's own session summaries, lower fidelity, never mixed with raw).
  transcriptSource  String @default("claude") @db.VarChar(32)

  turnCount     Int @default(0)
  messageCount  Int @default(0)
  toolCallCount Int @default(0)
  toolNames     Json? @db.JsonB
  touchedFiles  Json? @db.JsonB
  durationMs    Int?

  startedAt  DateTime
  endedAt    DateTime
  ingestedAt DateTime @default(now())

  collectionPeriod WorkEvaluationPeriod? @relation(fields: [collectionPeriodId], references: [id], onDelete: SetNull)

  @@unique([developerId, externalSessionId])
  @@index([developerId, startedAt])
  @@index([collectionPeriodId])
  @@schema("module/work-evaluation")
}

/// A work artifact declared by the member's installation agent (design notes,
/// research, prototypes that live in the company workspace but never reach a
/// commit). Declared layer only: it is context that must be corroborated by
/// fact-layer evidence before it can support a strong conclusion.
model WorkEvaluationDeclaredDocument {
  id              String @id @default(uuid()) @db.Uuid
  developerId String @db.Uuid
  workspaceKey    String @db.VarChar(128)

  title       String  @db.VarChar(255)
  path        String  @db.VarChar(512)
  description String? @db.Text
  content     String  @db.Text

  capturedAt DateTime
  createdAt  DateTime @default(now())

  @@unique([developerId, workspaceKey, path])
  @@index([developerId])
  @@schema("module/work-evaluation")
}

/// Self-reported facts of a member-side installation agent. Identity and
/// credential live in the shared `Installation` row (module/security, ADR-078);
/// this table is 1:1 with it and keeps only the evaluatee binding and host
/// facts. `developerId` is the single authorization fact for ingest: an agent
/// may only write evidence for its own evaluatee.
model WorkEvaluationAgentState {
  id               String @id @default(uuid()) @db.Uuid
  installationId   String @unique @db.Uuid
  developerId      String @db.Uuid
  hostname         String? @db.VarChar(255)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([developerId])
  @@schema("module/work-evaluation")
}

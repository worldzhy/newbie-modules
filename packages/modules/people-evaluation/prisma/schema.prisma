// consumer prisma tree on `newbie install`.

// !! ----------------------------------------------------------- //
// !!            [Module] People Evaluation models                //
// !! ----------------------------------------------------------- //
// * PeopleEvaluationRubricVersion                                //
// * PeopleEvaluationDimension                                    //
// * PeopleEvaluationPeriod                                       //
// * PeopleEvaluationMemberHomeGround                             //
// * PeopleEvaluationEvidence                                     //
// * PeopleEvaluationWorkDeliverable                              //
// * PeopleEvaluationScore                                        //
// * PeopleEvaluationAiAssessment                                 //
// * PeopleEvaluationImprovementItem                              //
// * PeopleEvaluationFloorTrigger                                 //
// * PeopleEvaluationImprovementPlan                              //
// * EvidenceSourceType (enum)                                    //
// * PeriodType (enum)                                            //
// * FloorTriggerStatus (enum)                                    //
// * ImprovementItemStatus (enum)                                 //
// ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

enum EvidenceSourceType {
  GIT
  INCIDENT
  TEST_TREND
  WORK_DELIVERABLE

  @@schema("module/people-evaluation")
}

enum PeriodType {
  COLLECTION
  REVIEW

  @@schema("module/people-evaluation")
}

enum FloorTriggerStatus {
  TRIGGERED
  ACKNOWLEDGED
  RESOLVED

  @@schema("module/people-evaluation")
}

enum ImprovementItemStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  DROPPED

  @@schema("module/people-evaluation")
}

/// Versioned rubric that anchors every evaluation period. Published
/// ex ante before any period of this version starts so members can
/// contest the standards. All dimensions, rules and the company
/// direction statement live here — revision history is the audit trail
/// of "what was promised when".
model PeopleEvaluationRubricVersion {
  id     String @id @default(uuid()) @db.Uuid
  version String @unique @db.VarChar(64) // e.g. "v0.1", "v1.0"

  // Dimension configuration JSON: [{dimensionKey, anchorLow, anchorHigh, fullLoadBaseRef}]
  dimensionConfig   Json @db.JsonB
  // Per-dimension full-load baseline refs keyed by dimensionKey
  fullLoadBaselines Json @db.JsonB
  // Floor rules: thresholds and "consecutive N periods" conditions
  floorRules        Json @db.JsonB
  // Company direction statement — anchor text for AI qualitative judgments
  companyDirectionStatement String @db.Text

  // ex ante anchor — members must see this before evaluation begins
  publishedAt DateTime
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluationDimensions PeopleEvaluationDimension[]
  evaluationPeriods    PeopleEvaluationPeriod[]
  aiAssessments        PeopleEvaluationAiAssessment[]

  @@index([isActive])
  @@schema("module/people-evaluation")
}

/// One evaluation dimension inside a rubric version. The same dimension key
/// can appear across rubric versions with revised anchors — each version is
/// a frozen snapshot so historical scores stay interpretable.
model PeopleEvaluationDimension {
  id              String @id @default(uuid()) @db.Uuid
  rubricVersionId String @db.Uuid

  // Unique within a rubric version, e.g. "architecture-design"
  dimensionKey String @db.VarChar(64)
  name         String @db.VarChar(128)
  anchorLow    Float?
  anchorHigh   Float?
  description  String? @db.Text

  rubricVersion PeopleEvaluationRubricVersion @relation(fields: [rubricVersionId], references: [id], onDelete: Cascade)

  @@unique([rubricVersionId, dimensionKey])
  @@index([rubricVersionId])
  @@schema("module/people-evaluation")
}

/// An evaluation period: COLLECTION (monthly, data gathering) or
/// REVIEW (quarterly, decision-making). Each period pins to exactly one
/// rubric version so all members inside it are scored against the same rules.
model PeopleEvaluationPeriod {
  id              String @id @default(uuid()) @db.Uuid
  rubricVersionId String @db.Uuid
  type            PeriodType
  periodStart     DateTime
  periodEnd       DateTime
  status          String @default("upcoming") @db.VarChar(16) // upcoming / active / closed

  // REVIEW periods may reference which COLLECTION periods are rolled up
  collectionPeriodIds Json? @db.JsonB

  rubricVersion PeopleEvaluationRubricVersion @relation(fields: [rubricVersionId], references: [id], onDelete: Cascade)

  homeGrounds   PeopleEvaluationMemberHomeGround[]
  evidences     PeopleEvaluationEvidence[]
  deliverables  PeopleEvaluationWorkDeliverable[]
  scores        PeopleEvaluationScore[]
  aiAssessments PeopleEvaluationAiAssessment[]

  @@index([rubricVersionId])
  @@index([type, periodStart])
  @@schema("module/people-evaluation")
}

/// One member's home-ground declaration for a period. Dual-circle model:
/// dimensions in `homeDimensions` get treated as the specialty circle
/// (higher weight + higher expectation), everything else is the growth
/// circle (lower weight but must show period-over-period growth).
model PeopleEvaluationMemberHomeGround {
  id        String @id @default(uuid()) @db.Uuid
  evaluateeUserId String @db.Uuid
  collectionPeriodId String @db.Uuid

  homeDimensions Json @db.JsonB // dimensionKey[]
  // Weights keyed by dimensionKey — member-visible contribution weight per dimension
  weights    Json   @db.JsonB
  declaredAt DateTime @default(now())

  period PeopleEvaluationPeriod @relation(fields: [collectionPeriodId], references: [id], onDelete: Cascade)

  @@unique([evaluateeUserId, collectionPeriodId])
  @@index([evaluateeUserId])
  @@schema("module/people-evaluation")
}

/// A single evidence datum collected automatically or submitted by the
/// member. Facts-only — no interpretation. Attributed to a member at
/// collection time; module handovers do not migrate historical rows.
model PeopleEvaluationEvidence {
  id           String @id @default(uuid()) @db.Uuid
  evaluateeUserId String @db.Uuid
  collectionPeriodId String @db.Uuid

  sourceType   EvidenceSourceType
  sourceRef    String? @db.VarChar(255) // e.g. "git:nw-backend", "incident:web-monitor#123"
  dimensionKey String? @db.VarChar(64) // which evaluation dimension this feeds

  payload     Json   @db.JsonB
  eventAt     DateTime // source event timestamp (git commit date, incident open time, ...)

  collectionPeriod PeopleEvaluationPeriod @relation(fields: [collectionPeriodId], references: [id], onDelete: Cascade)

  @@index([evaluateeUserId])
  @@index([collectionPeriodId])
  @@index([sourceType])
  @@index([evaluateeUserId, collectionPeriodId])
  @@unique([collectionPeriodId, sourceRef])
  @@schema("module/people-evaluation")
}

/// Non-code work (research, prototypes, process work) must be declared here
/// so it becomes first-class evidence — "work must be seen before it can be
/// evaluated". Input for AI qualitative judgment too.
model PeopleEvaluationWorkDeliverable {
  id           String @id @default(uuid()) @db.Uuid
  evaluateeUserId String @db.Uuid
  collectionPeriodId String @db.Uuid

  title        String @db.VarChar(255)
  link         String? @db.VarChar(2048)
  documentRef  String? @db.VarChar(255)
  description  String? @db.Text
  declaredAt   DateTime @default(now())

  collectionPeriod PeopleEvaluationPeriod @relation(fields: [collectionPeriodId], references: [id], onDelete: Cascade)

  @@index([evaluateeUserId])
  @@index([collectionPeriodId])
  @@schema("module/people-evaluation")
}

/// Per-member, per-collection-period, per-dimension numerical score.
/// Scores are machine-computed from evidence — humans never write them
/// directly. Evidence refs are frozen snapshots at score time so the
/// decision trail is replayable.
model PeopleEvaluationScore {
  id           String @id @default(uuid()) @db.Uuid
  evaluateeUserId String @db.Uuid
  collectionPeriodId String @db.Uuid
  dimensionKey String @db.VarChar(64)

  score        Decimal @db.Decimal(5, 2)
  evidenceRefs Json? @db.JsonB         // evidence id[] — null score is invalid
  weightAtScore Decimal? @db.Decimal(5, 4) // snapshot of weight at scoring time
  scoredAt     DateTime @default(now())
  scoredBy     String @default("machine") @db.VarChar(16) // machine / human / ai-reference

  collectionPeriod PeopleEvaluationPeriod @relation(fields: [collectionPeriodId], references: [id], onDelete: Cascade)

  @@unique([evaluateeUserId, collectionPeriodId, dimensionKey])
  @@index([evaluateeUserId, collectionPeriodId])
  @@schema("module/people-evaluation")
}

/// AI qualitative assessment — a reference text, NEVER feeds the numerical
/// score. Anchored to the published rubric's company direction statement,
/// which makes the "why" of any match / mismatch claim traceable. Visible
/// to the member — hiding it would only fuel distrust of "AI in evaluation".
model PeopleEvaluationAiAssessment {
  id           String @id @default(uuid()) @db.Uuid
  evaluateeUserId String @db.Uuid
  collectionPeriodId String @db.Uuid
  rubricVersionId String @db.Uuid

  promptVersion   String @db.VarChar(64)
  inputEvidenceRefs Json @db.JsonB        // evidence + deliverable ids
  outputText      String @db.Text
  // worldzhy's review mark
  reviewed        Boolean @default(false)
  reviewedAt      DateTime?
  reviewedByUserId String? @db.Uuid
  reviewNote      String? @db.Text

  collectionPeriod PeopleEvaluationPeriod @relation(fields: [collectionPeriodId], references: [id], onDelete: Cascade)
  rubricVersion    PeopleEvaluationRubricVersion @relation(fields: [rubricVersionId], references: [id], onDelete: Cascade)

  @@index([evaluateeUserId, collectionPeriodId])
  @@index([promptVersion])
  @@schema("module/people-evaluation")
}

/// An improvement item raised against a member — from a floor trigger,
/// manager observation, or AI review. Independently trackable so it can
/// cross period boundaries (e.g. PIP runs into the next quarter).
model PeopleEvaluationImprovementItem {
  id           String @id @default(uuid()) @db.Uuid
  evaluateeUserId String @db.Uuid

  triggeredBy  String @db.VarChar(32)       // floor_trigger / manager / ai
  dimensionKey String? @db.VarChar(64)
  title        String @db.VarChar(255)
  description  String? @db.Text
  status       ImprovementItemStatus @default(OPEN)
  openedAt     DateTime @default(now())
  closedAt     DateTime?

  @@index([evaluateeUserId])
  @@index([status])
  @@schema("module/people-evaluation")
}

/// Fire-and-forget floor trigger record. When a member hits "N consecutive
/// collection periods below threshold" on any dimension a row is written.
/// v0.x behavior: record only, no automatic action. v1.0: floor rules
/// published in rubric; triggers talk → PIP.
model PeopleEvaluationFloorTrigger {
  id           String @id @default(uuid()) @db.Uuid
  evaluateeUserId String @db.Uuid

  dimensionKey String @db.VarChar(64)
  consecutiveCollectionPeriods Int
  scoreSnapshot Json @db.JsonB
  status FloorTriggerStatus @default(TRIGGERED)

  triggeredAt DateTime @default(now())
  resolvedAt  DateTime?

  @@index([evaluateeUserId])
  @@index([status])
  @@index([evaluateeUserId, dimensionKey, status])
  @@schema("module/people-evaluation")
}

/// PIP (Performance Improvement Plan) — the decision infrastructure. A
/// single signed resolution by worldzhy ties everything together: what
/// triggered it, what the milestones are, and the final call. Every field
/// visible to the member.
model PeopleEvaluationImprovementPlan {
  id           String @id @default(uuid()) @db.Uuid
  evaluateeUserId String @db.Uuid

  triggerRefs  Json @db.JsonB           // improvement_item + floor_trigger ids
  startDate    DateTime
  endDate      DateTime
  checkpoints  Json @db.JsonB           // [{dueDate, description, status}]
  result       String? @db.VarChar(16)  // completed / failed / extended
  decisionNote String? @db.Text

  // Single-signer resolution
  decidedByUserId String? @db.Uuid
  decidedAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([evaluateeUserId])
  @@schema("module/people-evaluation")
}

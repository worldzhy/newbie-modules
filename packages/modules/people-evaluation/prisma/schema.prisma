// Prisma schema fragment for the people-evaluation module (ADR-029).
// This file is managed by @devbie/newbie-cli — assembled into the
// consumer prisma tree on `newbie install`.

// !! ----------------------------------------------------------- //
// !!            [Module] People Evaluation models                //
// !! ----------------------------------------------------------- //
// * PeopleEvaluationRubricVersion                                //
// * PeopleEvaluationDimension                                    //
// * PeopleEvaluationPeriod                                       //
// * PeopleEvaluationHomeGround                                   //
// * PeopleEvaluationMemberWorkspace                              //
// * PeopleEvaluationAgentSession                                 //
// * PeopleEvaluationEvidencePacket                               //
// * PeopleEvaluationAssessment                                   //
// * PeopleEvaluationPipPlan                                      //
// * PeopleEvaluationDeclaredDocument                             //
// * PeopleEvaluationCollectorInstallation                        //
// * PeriodType (enum)                                            //
// * PeriodStatus (enum)                                          //
// ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

enum PeriodType {
  COLLECTION
  REVIEW

  @@schema("module/people-evaluation")
}

enum PeriodStatus {
  UPCOMING
  ACTIVE
  CLOSED

  @@schema("module/people-evaluation")
}

/// Versioned rubric that anchors every evaluation period. Published ex ante
/// before any period of this version starts so members can contest the
/// standards. Dimensions (with their calibration anchors) live in their own
/// table — the single source of truth for what is being judged.
model PeopleEvaluationRubricVersion {
  id     String @id @default(uuid()) @db.Uuid
  version String @unique @db.VarChar(64) // e.g. "v0.1", "v1.0"

  // Floor rules: thresholds that the assessment agent must call out as risks.
  // Never applied mechanically — the agent reports them, a human decides.
  floorRules Json? @db.JsonB
  // Company direction statement — anchor text for every qualitative judgment
  companyDirectionStatement String @db.Text

  // ex ante anchor — members must see this before evaluation begins
  publishedAt DateTime
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evaluationDimensions PeopleEvaluationDimension[]
  evaluationPeriods    PeopleEvaluationPeriod[]

  @@index([isActive, publishedAt])
  @@schema("module/people-evaluation")
}

/// One evaluation dimension inside a rubric version. The same dimension key
/// can appear across rubric versions with revised anchors — each version is a
/// frozen snapshot so historical assessments stay interpretable.
model PeopleEvaluationDimension {
  id              String @id @default(uuid()) @db.Uuid
  rubricVersionId String @db.Uuid

  // Unique within a rubric version, e.g. "architecture-design"
  dimensionKey String  @db.VarChar(64)
  name         String  @db.VarChar(128)
  // Reference band the assessment is expected to land in
  anchorLow    Float?
  anchorHigh   Float?
  // Full-load reference baseline — qualitative industry anchor published ex ante
  fullLoadBaseRef String? @db.Text
  description     String? @db.Text
  // Versioned calibration examples: [{ level, kind: "positive"|"negative",
  // example, rationale }]. Anchors the agent's judgment across runs.
  calibrationExamples Json? @db.JsonB

  rubricVersion PeopleEvaluationRubricVersion @relation(fields: [rubricVersionId], references: [id], onDelete: Cascade)

  @@unique([rubricVersionId, dimensionKey])
  @@index([rubricVersionId])
  @@schema("module/people-evaluation")
}

/// An evaluation period: COLLECTION (monthly, evidence gathering) or
/// REVIEW (quarterly, decision-making). Each period pins to exactly one
/// rubric version so all members inside it are judged against the same rules.
model PeopleEvaluationPeriod {
  id              String @id @default(uuid()) @db.Uuid
  rubricVersionId String @db.Uuid
  type            PeriodType
  periodStart     DateTime
  periodEnd       DateTime
  status          PeriodStatus @default(UPCOMING)

  // REVIEW periods may reference which COLLECTION periods are rolled up
  collectionPeriodIds Json? @db.JsonB

  rubricVersion PeopleEvaluationRubricVersion @relation(fields: [rubricVersionId], references: [id], onDelete: Cascade)

  homeGrounds   PeopleEvaluationHomeGround[]
  agentSessions PeopleEvaluationAgentSession[]
  packets       PeopleEvaluationEvidencePacket[]
  assessments   PeopleEvaluationAssessment[]

  @@index([rubricVersionId])
  @@index([type, periodStart])
  @@schema("module/people-evaluation")
}

/// One evaluatee's home-ground declaration for a period. Dual-circle model:
/// dimensions in `homeDimensions` are the specialty circle. No weights — the
/// declaration is context for the assessment agent, never a scoring input.
model PeopleEvaluationHomeGround {
  id                 String @id @default(uuid()) @db.Uuid
  evaluateeUserId    String @db.Uuid
  collectionPeriodId String @db.Uuid

  homeDimensions Json @db.JsonB // dimensionKey[]
  declaredAt     DateTime @default(now())

  period PeopleEvaluationPeriod @relation(fields: [collectionPeriodId], references: [id], onDelete: Cascade)

  @@unique([evaluateeUserId, collectionPeriodId])
  @@index([evaluateeUserId])
  @@schema("module/people-evaluation")
}

/// A workspace declared by the member inside the IDE and reported by the
/// collector. The company/personal split is self-declared and never
/// adjudicated server-side: the incentive structure is that company work
/// marked personal loses evidence, and personal work marked company finds no
/// factual counterpart in the platform repositories.
///
/// `repositories` is the workspace → repository path mapping: the collector
/// only reports, it never matches on the server.
model PeopleEvaluationMemberWorkspace {
  id              String @id @default(uuid()) @db.Uuid
  evaluateeUserId String @db.Uuid

  // IDE-side workspace identifier (stable across reports)
  workspaceKey String @db.VarChar(128)
  rootPath     String @db.VarChar(512)
  isCompany    Boolean @default(true)
  // [{ path, platform, repositoryFullName }]
  repositories Json    @db.JsonB

  installationId String? @db.Uuid
  reportedAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  installation  PeopleEvaluationCollectorInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  agentSessions PeopleEvaluationAgentSession[]

  @@unique([evaluateeUserId, workspaceKey])
  @@index([evaluateeUserId])
  @@schema("module/people-evaluation")
}

/// Index row for one AI-agent coding session collected from a company
/// workspace. The transcript itself lives in ClickHouse
/// (`people_evaluation_session_messages`); this row carries everything the
/// assessment agent needs to decide whether to drill into the transcript.
model PeopleEvaluationAgentSession {
  id                 String  @id @default(uuid()) @db.Uuid
  evaluateeUserId    String  @db.Uuid
  collectionPeriodId String? @db.Uuid
  memberWorkspaceId  String? @db.Uuid

  // Collector-side session identifier (stable, e.g. the IDE transcript id)
  externalSessionId String @db.VarChar(128)
  workspaceKey      String @db.VarChar(128)
  model             String @default("") @db.VarChar(128)

  turnCount     Int @default(0)
  messageCount  Int @default(0)
  toolCallCount Int @default(0)
  toolNames     Json? @db.JsonB
  touchedFiles  Json? @db.JsonB
  durationMs    Int?

  startedAt  DateTime
  endedAt    DateTime
  ingestedAt DateTime @default(now())

  collectionPeriod PeopleEvaluationPeriod?             @relation(fields: [collectionPeriodId], references: [id], onDelete: SetNull)
  memberWorkspace  PeopleEvaluationMemberWorkspace?    @relation(fields: [memberWorkspaceId], references: [id], onDelete: SetNull)

  @@unique([evaluateeUserId, externalSessionId])
  @@index([evaluateeUserId, startedAt])
  @@index([collectionPeriodId])
  @@schema("module/people-evaluation")
}

/// Deterministic evidence manifest for one evaluatee × period. Built by code
/// (platform facts + declared context), never by the model, so "what was
/// available" and "what was actually consumed" can be compared afterwards.
model PeopleEvaluationEvidencePacket {
  id                 String @id @default(uuid()) @db.Uuid
  evaluateeUserId    String @db.Uuid
  collectionPeriodId String @db.Uuid

  // [{ id, layer, source, summary, eventAt, attributedBy }]
  manifest      Json @db.JsonB
  // SHA-256 over canonical manifest — detects drift between run and review
  contentHash   String @db.VarChar(64)
  // { fact: { total, bySource }, declared: { total, bySource }, unlinked: number }
  coverageStats Json @db.JsonB
  generatedAt   DateTime @default(now())

  period      PeopleEvaluationPeriod       @relation(fields: [collectionPeriodId], references: [id], onDelete: Cascade)
  assessments PeopleEvaluationAssessment[]

  @@unique([evaluateeUserId, collectionPeriodId])
  @@index([evaluateeUserId])
  @@schema("module/people-evaluation")
}

/// One assessment run over an evidence packet. Dimension scores are the
/// model's judgments with explicit confidence and coverage — they are not
/// mechanically recomputable from evidence counts, and there is deliberately
/// no composite score.
model PeopleEvaluationAssessment {
  id                 String @id @default(uuid()) @db.Uuid
  evaluateeUserId    String @db.Uuid
  collectionPeriodId String @db.Uuid
  packetId           String @db.Uuid

  // Blind evaluation: the model saw `subject-{uuid}`, never the real identity
  blindSubjectId String @db.VarChar(64)
  promptVersion  String @db.VarChar(64)
  model          String @db.VarChar(128)

  // [{ dimensionKey, score, confidence: "high"|"medium"|"low",
  //    coverage: { included, drilled, skipped, note },
  //    evidenceRefs: string[], rationale, unresolved? }]
  dimensionScores Json  @db.JsonB
  overallText     String @db.Text
  highlights      Json? @db.JsonB
  risks           Json? @db.JsonB
  // Skeptic challenges the synthesis could not answer
  unresolved      Json? @db.JsonB
  // Items the token budget cut off — never silently truncated
  skipped         Json? @db.JsonB
  // [{ model, dimensionScores }] when dual-model mode is enabled
  disagreement    Json? @db.JsonB

  reviewedByUserId String?   @db.Uuid
  reviewedAt       DateTime?
  reviewNote       String?   @db.Text
  createdAt        DateTime @default(now())

  period PeopleEvaluationPeriod       @relation(fields: [collectionPeriodId], references: [id], onDelete: Cascade)
  packet PeopleEvaluationEvidencePacket @relation(fields: [packetId], references: [id], onDelete: Cascade)

  @@index([evaluateeUserId, collectionPeriodId])
  @@index([packetId])
  @@schema("module/people-evaluation")
}

/// PIP (Performance Improvement Plan) — the decision infrastructure. A single
/// signed resolution by the supervisor ties everything together: which
/// assessments triggered it, what the milestones are, and the final call.
/// Every field visible to the member.
model PeopleEvaluationPipPlan {
  id              String @id @default(uuid()) @db.Uuid
  evaluateeUserId String @db.Uuid

  triggerRefs  Json     @db.JsonB // assessment + risk ids
  startDate    DateTime
  endDate      DateTime
  checkpoints  Json     @db.JsonB // [{dueDate, description, status}]
  result       String?  @db.VarChar(16) // completed / failed / extended
  decisionNote String?  @db.Text

  decidedByUserId String?   @db.Uuid
  decidedAt       DateTime?
  createdAt       DateTime @default(now())

  @@index([evaluateeUserId])
  @@schema("module/people-evaluation")
}

/// A work artifact declared by the member's collector (design notes, research,
/// prototypes that live in the company workspace but never reach a commit).
/// Declared layer only: it is context that must be corroborated by fact-layer
/// evidence before it can support a strong conclusion.
model PeopleEvaluationDeclaredDocument {
  id              String @id @default(uuid()) @db.Uuid
  evaluateeUserId String @db.Uuid
  workspaceKey    String @db.VarChar(128)

  title       String  @db.VarChar(255)
  refPath     String  @db.VarChar(512)
  description String? @db.Text
  content     String  @db.Text

  capturedAt DateTime
  createdAt  DateTime @default(now())

  @@unique([evaluateeUserId, workspaceKey, refPath])
  @@index([evaluateeUserId])
  @@schema("module/people-evaluation")
}

/// Enrollment for the member-side work collector (ADR-029). Same shape as the
/// backend-monitor installation: random UUID token, SHA-256 hash at rest,
/// plaintext returned once, soft revocation. The row carries the member the
/// token may report for, so a collector can never write sessions for someone
/// else.
model PeopleEvaluationCollectorInstallation {
  id           String  @id @default(uuid()) @db.Uuid
  label        String  @db.VarChar(128)
  memberUserId String  @db.Uuid
  tokenHash    String  @unique @db.VarChar(64)
  hostname     String? @db.VarChar(255)
  firstSeenAt  DateTime?
  lastSeenAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaces PeopleEvaluationMemberWorkspace[]

  @@index([memberUserId])
  @@schema("module/people-evaluation")
}

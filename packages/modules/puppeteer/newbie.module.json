{
  "key": "puppeteer",
  "module": {
    "file": "puppeteer.module",
    "className": "PuppeteerModule"
  },
  "config-service": {
    "puppeteer": {
      "chromiumPath": "process.env.CHROMIUM_PATH ?? ''"
    }
  },
  "env": {
    "CHROMIUM_PATH": ""
  },
  "dependencies": {
    "puppeteer": "latest"
  }
}

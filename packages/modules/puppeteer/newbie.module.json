{
  "key": "puppeteer",
  "layer": "infrastructure",
  "module": {
    "file": "puppeteer.module",
    "className": "PuppeteerModule"
  },
  "config-service": {
    "puppeteer": {
      "chromiumPath": "process.env.CHROMIUM_PATH ?? ''",
      "noSandbox": "process.env.PUPPETEER_NO_SANDBOX !== 'false'"
    }
  },
  "env": {
    "CHROMIUM_PATH": "",
    "PUPPETEER_NO_SANDBOX": "true"
  },
  "dependencies": {
    "puppeteer": "latest"
  }
}

// Self-reported facts of one module-hub installation: a newbie backend or a
// fewbie SSR process. Identity and credential live in the shared `Installation`
// row (module/security, ADR-078); this table is 1:1 with it and keeps only what
// a report carries. The hub is project-agnostic and never parses host-side
// project/application grouping.
//
// Lifecycle (never-seen / online / stale) is derived at read time from the
// shared row's timestamps; this table adds no explicit state.
//
// `installationId` is a plain scalar, not a relation: Prisma relations cannot
// cross schema boundaries in this repository, and the shared table must not
// depend on optional collector modules. 1:1 is guaranteed by the write path.
model ModuleHubAgentState {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  installationId String @unique @db.Uuid

  // Optional source-repository URL, supplied by the host at enrollment.
  repoUrl String? @db.VarChar(255)

  // Runtime facts self-reported at process start and refreshed on each report.
  // One of "newbie", "fewbie", "other-node".
  framework String? @db.VarChar(32)
  // Formatted "<framework>@<version>", e.g. "newbie@0.2".
  frameworkVersion String? @db.VarChar(64)
  // Self-reported deployed version, typically a git sha or a semver.
  appVersion String? @db.VarChar(64)
  // Self-reported environment, e.g. "prod"; informational, never drives logic.
  env String? @db.VarChar(64)
  // Self-reported instance identity: EC2 instance id, hostname, pod name.
  instanceId String? @db.VarChar(128)

  // Derived from the first module entry's sourceCommit in the last reported
  // snapshot.
  registrySourceCommit String? @db.VarChar(64)
  // Module snapshot in the shape of `newbie status --json` modules[] entries:
  // [{key, version, sourceCommit, localPatches, installed, hasSchema,
  //   missingEnv, updateAvailable, drift?}]
  modulesSnapshot Json?

  // Desired module set recorded by host users, in newbie-modules.json shape.
  // Read-time "target vs actual" display only: the hub never dispatches it as
  // an execution channel.
  targetSpec Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("module/module-hub")
}

// One row per (module, registry commit): an immutable registry catalog entry
// inserted by the GitHub push webhook, with a periodic fallback sync.
model ModuleHubRelease {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  moduleKey String @db.VarChar(64)
  // Registry commit at which this module snapshot was seen.
  sourceCommit String @db.VarChar(64)
  // The newbie.module.json manifest at that commit.
  manifest Json @db.JsonB
  // Commit date of `sourceCommit` in GitHub, used at read time to tell whether
  // an installed pin predates the latest release. Null on legacy rows.
  committedAt DateTime?

  publishedAt DateTime @default(now())

  @@unique([moduleKey, sourceCommit])
  @@schema("module/module-hub")
}

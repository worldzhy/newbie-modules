// !! ------------------------------------------------------------ //
// !!                  [Module] URL Check models                   //
// !! ------------------------------------------------------------ //
// * UrlCheckTarget                                                //
// * UrlCheckIncident                                              //
// !! ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

// One external URL probed on a fixed cadence (ADR-022). A target is owned by a
// host grouping entity through `groupId`, a cross-schema foreign key to
// application.Application. Check parameters are global defaults rather than
// per-target settings: a 60s probe interval driven by the host job, a 10s
// timeout, and "up" for any final response below HTTP 400.
//
// `consecutiveFailures` and `isAlertOpen` drive the down/recovered state
// machine: the outage alert opens at 3 consecutive failures and closes only
// after 3 consecutive successes while open (ADR-024). Deactivating a target
// stops probing and closes any open alert within the same transaction.
model UrlCheckTarget {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId               String    @db.Uuid
  name                  String    @db.VarChar(255)
  url                   String    @db.VarChar(2048)
  isActive              Boolean   @default(true)
  consecutiveFailures   Int       @default(0)
  // Success streak while an alert is open; 0 outside an outage. Recovery needs
  // 3 successes in a row (ADR-024).
  consecutiveSuccesses  Int       @default(0)
  isAlertOpen           Boolean   @default(false)
  // When the open outage alert started; null while no alert is open.
  alertOpenedAt         DateTime?
  lastCheckedAt         DateTime?
  lastStatusCode        Int?
  lastIsUp              Boolean?
  createdByUserId       String?   @db.Uuid
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  application           Application @relation(fields: [groupId], references: [id], onDelete: Cascade)
  incidents             UrlCheckIncident[]

  @@index([groupId])
  @@index([isActive])
  @@schema("module/url-check")
}

// One outage episode of a monitored target (ADR-023): opened in the same
// transaction as the outage alert and closed with it (`recoveredAt`,
// `durationMs`). Incident history is the durable record of outages; raw
// per-check rows stay in ClickHouse under a 90-day TTL.
model UrlCheckIncident {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetId                String          @db.Uuid
  openedAt                DateTime
  // Null while the outage is ongoing.
  recoveredAt             DateTime?
  // Computed when the incident closes; null while ongoing.
  durationMs              Int?
  // Peak consecutive failures observed during the incident.
  peakConsecutiveFailures Int
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  target                  UrlCheckTarget  @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@index([targetId])
  @@index([targetId, recoveredAt])
  @@schema("module/url-check")
}

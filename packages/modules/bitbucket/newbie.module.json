{
  "key": "bitbucket",
  "layer": "infrastructure",
  "wiring": {
    "file": "bitbucket.module",
    "className": "BitbucketModule"
  },
  "requires": {
    "config": {
      "bitbucket": {
        "accessToken": "process.env.BITBUCKET_ACCESS_TOKEN",
        "apiEmail": "process.env.BITBUCKET_API_EMAIL",
        "apiToken": "process.env.BITBUCKET_API_TOKEN"
      }
    },
    "env": {
      "BITBUCKET_ACCESS_TOKEN": "",
      "BITBUCKET_API_EMAIL": "",
      "BITBUCKET_API_TOKEN": ""
    }
  }
}

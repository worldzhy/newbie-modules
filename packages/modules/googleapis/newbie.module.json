{
  "key": "googleapis",
  "layer": "infrastructure",
  "wiring": {
    "file": "googleapis.module",
    "className": "GoogleAPIsModule",
    "prismaSchema": "prisma/schema.prisma"
  },
  "requires": {
    "modules": ["security"],
    "config": {
      "googleapis": {
        "credentials": {
          "apiKey": "process.env.GOOGLE_CREDENTIALS_API_KEY",
          "serviceAccount": "process.env.GOOGLE_CREDENTIALS_SERVICE_ACCOUNT"
        },
        "googleSharedDriveId": "process.env.GOOGLE_SHARED_DRIVE_ID"
      }
    },
    "env": {
      "GOOGLE_CREDENTIALS_API_KEY": "",
      "GOOGLE_CREDENTIALS_SERVICE_ACCOUNT": "",
      "GOOGLE_SHARED_DRIVE_ID": ""
    }
  },
  "dependencies": {
    "@googleapis/drive": "latest",
    "multer": "latest",
    "@googleapis/forms": "latest",
    "@googleapis/sheets": "latest"
  },
  "devDependencies": {
    "@types/multer": "latest"
  }
}

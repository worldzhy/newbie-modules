// !! ------------------------------------------------------------ //
// !!            [Module] Google Drive models             //
// !! ------------------------------------------------------------ //
// * GoogleDriveFile                                                    //
// * GoogleDrivePermission                                          //
// * ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ //

model GoogleDriveFile {
  id             String                  @id // Generated by google
  name           String
  type           String?
  size           Int? // in bytes
  iconLink       String?
  webViewLink    String?
  webContentLink String?
  parentId       String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  permissions    GoogleDrivePermission[]

  @@schema("module/googleapis")
}

model GoogleDrivePermission {
  id           Int             @id @default(autoincrement())
  permissionId String // Generated by google, (permissionId + fileId) is unique.
  type         String
  role         String
  email        String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  file         GoogleDriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId       String

  @@schema("module/googleapis")
}

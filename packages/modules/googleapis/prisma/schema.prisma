// !! ------------------------------------------------------------ //
// !!                 [Module] Google Drive models                 //
// !! ------------------------------------------------------------ //
// * GoogleDriveFile                                               //
// * GoogleDrivePermission                                         //
// !! ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

model GoogleDriveFile {
  id             String                  @id // Assigned by Google Drive.
  name           String
  type           String?
  size           Int? // bytes
  iconLink       String?
  webViewLink    String?
  webContentLink String?
  parentId       String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  permissions    GoogleDrivePermission[]

  @@schema("module/googleapis")
}

model GoogleDrivePermission {
  id           Int             @id @default(autoincrement())
  permissionId String // Assigned by Google Drive; scoped to fileId, not enforced here.
  type         String
  role         String
  email        String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  file         GoogleDriveFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  fileId       String

  @@schema("module/googleapis")
}

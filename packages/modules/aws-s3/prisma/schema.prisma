// !! ------------------------------------------------------------ //
// !!                    [Module] AWS S3 models                    //
// !! ------------------------------------------------------------ //
// * S3File                                                        //
// * S3Bucket                                                      //
// !! ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

model S3File {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  type           String? // "folder" for directories, otherwise the file extension.
  size           Int? // bytes
  s3Bucket       String
  s3Key          String // Object key within the bucket.
  s3Response     Json?
  parentId       String?  @db.Uuid
  uploadId       String? // Multipart upload ID.
  uploadProgress Int?     @default(100) // 0 during a multipart upload, 100 when complete.
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([s3Bucket, s3Key])
  @@schema("module/aws-s3")
}

model S3Bucket {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("module/aws-s3")
}

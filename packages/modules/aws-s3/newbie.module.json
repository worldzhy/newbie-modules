{
  "key": "aws-s3",
  "layer": "foundation",
  "module": {
    "file": "aws-s3.module",
    "className": "AwsS3Module"
  },
  "schema": "prisma/schema.prisma",
  "moduleDependencies": ["aws-identity"],
  "config-service": {
    "aws-s3": {
      "region": "process.env.AWS_S3_REGION || 'us-east-1'",
      "bucket": "process.env.AWS_S3_BUCKET",
      "signedUrlExpiresIn": "int(process.env.AWS_S3_SIGNED_URL_EXPIRESIN, 1800)",
      "cdnHostname": "process.env.AWS_S3_CDN_HOSTNAME"
    }
  },
  "env": {
    "AWS_S3_REGION": "",
    "AWS_S3_BUCKET": "",
    "AWS_S3_SIGNED_URL_EXPIRESIN": "1800"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "latest",
    "@aws-sdk/s3-request-presigner": "latest",
    "validator": "latest"
  },
  "devDependencies": {
    "@types/multer": "latest",
    "@types/validator": "latest"
  }
}

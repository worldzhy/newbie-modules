// !!            [Module] Notification Center models         //
// !! ------------------------------------------------------------ //
// * NotificationSetting                                          //
// * NotificationRecord                                           //
// * NotificationReceipt                                          //
// * NotificationCenterSetting                                    //
// * ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ //

// Per-notification delivery settings. Business code declares a notification
// at startup (a Notification subclass registering itself through
// NotificationRegistryService) and NotificationSettingService persists one
// row per key. The database row wins for runtime-editable fields
// (defaultSeverity, pushEnabled): declarations only create
// missing rows, never override operator edits.
model NotificationSetting {
  key            String    @id @db.VarChar(100)
  name           String    @db.VarChar(255)
  // Handlebars-style template rendered with the notify() context.
  titleTemplate  String    @db.VarChar(512)
  // Optional multi-line detail template.
  detailTemplate String?   @db.Text
  defaultSeverity String   @db.VarChar(10)
  // Per-notification push master switch; the center master switch must also
  // be on for a push to fire.
  pushEnabled    Boolean   @default(true)
  // Delivery scope: "system" notifications are platform-wide and pushed
  // through the host-provided push port; "project" notifications are routed
  // to the owning project's bound chats by the host.
  scope          String    @default("project") @db.VarChar(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("module/notification-center")
}

// One platform-wide row per delivered notification event. Per-user read state
// lives in NotificationReceipt, so fan-out needs no writes: a missing receipt
// simply means "unread" for that user.
model NotificationRecord {
  id        String   @id @default(uuid()) @db.Uuid
  // Key of the notification this record was produced from.
  notificationKey String @db.VarChar(100)
  // Resolved severity for this delivery (notification default or an explicit
  // override passed to notify()).
  severity  String   @db.VarChar(10)
  title     String   @db.VarChar(512)
  detail    String?  @db.Text
  // Structured context passed to notify(); preserved for the notification
  // detail panels and downstream consumers.
  payload   Json?
  // Optional idempotency key: when provided, notify() is a no-op if a row with
  // the same key already exists. Nullable unique allows multiple nulls.
  deduplicationKey String? @db.VarChar(255)
  // Generic scope identifier (project id, tenant id, ...). Meaning is owned by
  // the registering notification.
  projectId String?  @db.Uuid
  // Frontend relative path the notification deep-links to.
  link      String?  @db.VarChar(512)
  createdAt DateTime @default(now())

  receipts NotificationReceipt[]

  @@unique([deduplicationKey])
  @@index([createdAt])
  @@index([notificationKey])
  @@index([projectId])
  @@schema("module/notification-center")
}

// Lazy per-user read marker, created only when a user opens / marks a
// notification. Deleting a record removes its markers.
model NotificationReceipt {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  notificationId String       @db.Uuid
  readAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())

  notification NotificationRecord @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
  @@schema("module/notification-center")
}

// Singleton (fixed id) notification-center settings; the row is created on
// first read with the defaults below.
model NotificationCenterSetting {
  id      Int @id

  // Master switch for chat push through the host-provided push port. A
  // notification push only fires when both this switch and the notification's
  // own pushEnabled are on.
  pushEnabled Boolean @default(false)
  // Notifications below this severity are dropped before delivery.
  minimumSeverity String @default("high") @db.VarChar(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("module/notification-center")
}

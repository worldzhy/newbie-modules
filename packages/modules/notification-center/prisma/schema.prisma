// * NotificationCenterSetting                                    //
// * NotificationDeliveryRule                                     //
// * NotificationDeliveryAttempt                                  //
// * ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ //

// Per-notification delivery settings. Business code declares a notification at
// startup (a Notification subclass registering itself through
// NotificationRegistryService) and NotificationSettingService persists one row
// per key. The database row wins for the runtime-editable field
// (isPushEnabled): declarations only create missing rows, never override
// operator edits. Severity is not stored here: it belongs to the producer and
// is passed on every notify() (ADR-062 "severity contract").
model NotificationSetting {
  key            String    @id @db.VarChar(100)
  name           String    @db.VarChar(255)
  // Handlebars-style template rendered with the notify() context.
  titleTemplate  String    @db.VarChar(512)
  // Optional multi-line detail template.
  detailTemplate String?   @db.Text
  // Per-notification push master switch; the center master switch must also
  // be on for a push to fire.
  isPushEnabled  Boolean   @default(true)
  // Delivery scope: "system" notifications are platform-wide and pushed
  // through the host-provided push port; "project" notifications are routed
  // to the owning project's bound chats by the host.
  scope          String    @default("project") @db.VarChar(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("module/notification-center")
}

// One platform-wide row per delivered notification event. Per-user read state
// lives in NotificationReceipt, so fan-out needs no writes: a missing receipt
// simply means "unread" for that user.
model NotificationRecord {
  id        String   @id @default(uuid()) @db.Uuid
  // Key of the notification this record was produced from.
  notificationKey String @db.VarChar(100)
  // Severity supplied by the producer for this delivery (ADR-062).
  severity  String   @db.VarChar(10)
  title     String   @db.VarChar(512)
  detail    String?  @db.Text
  // Structured context passed to notify(); preserved for the notification
  // detail panels and downstream consumers.
  payload   Json?
  // Optional idempotency key: when provided, notify() is a no-op if a row with
  // the same key already exists. Nullable unique allows multiple nulls.
  deduplicationKey String? @db.VarChar(255)
  // Generic scope identifier (project id, tenant id, ...). Meaning is owned by
  // the registering notification.
  projectId String?  @db.Uuid
  // Frontend relative path the notification deep-links to.
  link      String?  @db.VarChar(512)
  // Lifecycle state of alert-kind messages: "firing" (default) or "resolved".
  // Plain event notifications keep "firing"; the frontend uses it to pair and
  // dim resolved records (ADR-051, ADR-065).
  status    String    @db.VarChar(10) @default("firing")
  // Delivery time of the resolved event of this record.
  recoveredAt DateTime?
  // Where this delivery came from (ADR-065): "alert" for records produced by
  // the alert domain, "event" for plain event producers. No database foreign
  // key crosses domains — the id is a string.
  sourceType String? @db.VarChar(20)
  sourceRef  String? @db.VarChar(100)
  createdAt DateTime @default(now())

  receipts     NotificationReceipt[]
  pushFailures NotificationPushFailure[]

  @@unique([deduplicationKey])
  @@index([createdAt])
  @@index([notificationKey])
  @@index([projectId])
  @@index([status])
  @@index([sourceType, sourceRef])
  @@schema("module/notification-center")
}

// Lazy per-user read marker, created only when a user opens / marks a
// notification. Deleting a record removes its markers.
model NotificationReceipt {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  notificationId String       @db.Uuid
  readAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())

  notification NotificationRecord @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
  @@schema("module/notification-center")
}

// Per-recipient push failure record. Written by NotificationCenterService when
// the host push port reports a failed delivery; resolved automatically when the
// same recipient succeeds on a later push. The recipientKey is an opaque string
// defined by the host (recommended: `${platform}:${recipientType}:${recipientId}`).
model NotificationPushFailure {
  id                   String   @id @default(uuid()) @db.Uuid
  notificationRecordId String?  @db.Uuid
  recipientKey         String   @db.VarChar(255)
  error                String   @db.VarChar(1000)
  createdAt            DateTime @default(now())
  resolvedAt           DateTime?

  notificationRecord NotificationRecord? @relation(fields: [notificationRecordId], references: [id], onDelete: Cascade)

  @@index([notificationRecordId])
  @@index([recipientKey, resolvedAt])
  @@schema("module/notification-center")
}

// Singleton (fixed id) notification-center settings; the row is created on
// first read with the defaults below.
model NotificationCenterSetting {
  id      Int @id

  // Master switch for chat push through the host-provided push port. A
  // notification push only fires when both this switch and the notification's
  // own isPushEnabled are on.
  isPushEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("module/notification-center")
}

// Ordered delivery rules (ADR-062). The first enabled rule whose condition
// matches decides the delivery; when nothing matches, delivery is suppressed.
// Rules are evaluated per delivery instead of being frozen on an alert: the
// alert lives in its own domain (ADR-065) and its severity is stable across
// firing and resolved, so both land on the same side of the rules. Two default
// rules are seeded on a fresh install so high and critical signals keep pushing
// without any operator action.
model NotificationDeliveryRule {
  id        String   @id @default(uuid()) @db.Uuid
  // Ascending evaluation order; lower runs first.
  priority  Int      @unique
  // DeliveryCondition object: state, severityAtLeast, notificationKeys,
  // projectIds, tags. Absent fields do not filter; `[]` never matches.
  condition Json
  action    String   @db.VarChar(10)
  isEnabled Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("module/notification-center")
}

// One row per delivery decision (ADR-062). Makes every push or suppression
// explainable: which rule decided it and, when suppressed, why.
model NotificationDeliveryAttempt {
  id       String   @id @default(uuid()) @db.Uuid
  recordId String   @db.Uuid
  decision String   @db.VarChar(10)
  reason   String?  @db.VarChar(40)
  ruleId   String?  @db.Uuid
  // Real-time interception reason (ADR-063): subscription-off |
  // recovery-opt-out | channel-off | no-port. Kept apart from `reason` so a
  // rule can deliver while the runtime segment keeps the push in-app.
  runtimeReason String? @db.VarChar(40)

  createdAt DateTime @default(now())

  @@index([recordId])
  @@index([createdAt])
  @@schema("module/notification-center")
}

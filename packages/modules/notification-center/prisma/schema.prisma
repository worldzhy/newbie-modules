// * NotificationReceipt                                          //
// * NotificationSetting                                          //
// * ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ //

// A declared notification category. Business code registers a type at startup
// (NotificationTypeRegistryService.register) and declares a database row
// (NotificationTypeService.upsertDeclaration). The database row wins for
// runtime-editable fields (defaultSeverity, pushEnabled, channelGroupId):
// declarations only create missing rows, never override operator edits.
model NotificationType {
  key            String    @id @db.VarChar(100)
  name           String    @db.VarChar(255)
  // Handlebars-style template rendered with the notify() context, e.g.
  // "{{project}} {{source}} 新增 {{count}} 个风险".
  titleTemplate  String    @db.VarChar(512)
  // Optional multi-line detail template.
  detailTemplate String?   @db.Text
  defaultSeverity String   @db.VarChar(10)
  // Per-type push master switch; falls back to the platform setting when the
  // type row does not specify a channel group.
  pushEnabled    Boolean   @default(true)
  // Optional message-bot channel group override for this type.
  channelGroupId String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("module/notification-center")
}

// Explicit per-type channel selection (finer granularity than a channel
// group). When a type has at least one row here, push delivery goes to these
// channels directly, bypassing both the type group and the platform default.
// Scalar ids only: no cross-schema relation to message-bot.
model NotificationTypeChannel {
  id                  String @id @default(uuid()) @db.Uuid
  notificationTypeKey String @db.VarChar(100)
  // Scalar id of a message-bot channel.
  channelId           String @db.Uuid

  createdAt DateTime @default(now())

  @@unique([notificationTypeKey, channelId])
  @@index([notificationTypeKey])
  @@schema("module/notification-center")
}

// One platform-wide row per delivered notification event. Per-user read state
// lives in NotificationReceipt, so fan-out needs no writes: a missing receipt
// simply means "unread" for that user.
model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  // Key of the NotificationType this notification was produced from.
  typeKey   String   @db.VarChar(100)
  // Resolved severity for this delivery (type default or an explicit override
  // passed to notify()).
  severity  String   @db.VarChar(10)
  title     String   @db.VarChar(512)
  detail    String?  @db.Text
  // Structured context passed to notify(); preserved for the notification
  // detail panels and downstream consumers.
  payload   Json?
  // Optional idempotency key: when provided, notify() is a no-op if a row with
  // the same key already exists. Nullable unique allows multiple nulls.
  deduplicationKey String? @db.VarChar(255)
  // Generic scope identifier (project id, tenant id, ...). Meaning is owned by
  // the registering type.
  projectId String?  @db.Uuid
  // Frontend relative path the notification deep-links to.
  link      String?  @db.VarChar(512)
  createdAt DateTime @default(now())

  receipts NotificationReceipt[]

  @@unique([deduplicationKey])
  @@index([createdAt])
  @@index([typeKey])
  @@index([projectId])
  @@schema("module/notification-center")
}

// Lazy per-user read marker, created only when a user opens / marks a
// notification. Deleting a notification removes its markers.
model NotificationReceipt {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  notificationId String       @db.Uuid
  readAt         DateTime     @default(now())
  createdAt      DateTime     @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@index([userId])
  @@schema("module/notification-center")
}

// Singleton (fixed id) platform notification settings; the row is created on
// first read with the defaults below.
model NotificationSetting {
  id      Int @id

  inAppEnabled Boolean @default(true)
  // Master switch for Lark/Slack push through the message-bot module. A type
  // push only fires when both this switch and the type's own pushEnabled are on.
  pushEnabled Boolean @default(false)
  // Notifications below this severity are dropped before delivery.
  minimumSeverity String @default("high") @db.VarChar(10)
  // Default message-bot channel group for types that do not declare their own.
  channelGroupId String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("module/notification-center")
}

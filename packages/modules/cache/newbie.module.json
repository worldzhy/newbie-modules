{
  "key": "cache",
  "module": {
    "file": "cache.module",
    "className": "NewbieCacheModule"
  },
  "config-service": {
    "cache": {
      "memory": {
        "ttl": 3600000,
        "lruSize": 1000
      },
      "redis": {
        "ttl": 86400000,
        "host": "process.env.CACHE_REDIS_HOST",
        "port": "int(process.env.CACHE_REDIS_PORT, 6379)",
        "user": "process.env.CACHE_REDIS_USER",
        "password": "process.env.CACHE_REDIS_PASSWORD"
      }
    }
  },
  "env": {
    "CACHE_REDIS_HOST": "localhost",
    "CACHE_REDIS_PORT": "6379",
    "CACHE_REDIS_USER": "",
    "CACHE_REDIS_PASSWORD": ""
  },
  "dependencies": {
    "@keyv/redis": "latest",
    "@nestjs/cache-manager": "latest",
    "cache-manager": "latest",
    "cacheable": "latest",
    "keyv": "latest"
  },
  "devDependencies": {
    "@types/cache-manager": "latest"
  }
}

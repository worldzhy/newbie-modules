// !!                [Module] AWS CloudWatch models                //
// !! ------------------------------------------------------------ //
// * Ec2Instance                                                   //
// * RdsInstance                                                   //
// !! ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

// Both instance models are scoped by `accountId`, a plain column with no
// foreign key: the AWS account owns the resource. Credentials and the region
// list come from the aws-identity binding (AwsCrossAccountBinding) resolved at
// collection time.
model Ec2Instance {
  id          String   @id @default(uuid()) @db.Uuid
  instanceId  String
  name        String
  status      String?
  region      String
  isWatching  Boolean  @default(false)
  accountId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([instanceId, accountId])
  @@index([accountId])
  @@schema("module/aws-cloudwatch")
}

model RdsInstance {
  id          String   @id @default(uuid()) @db.Uuid
  instanceId  String   @unique // AWS DbiResourceId
  name        String // AWS DBInstanceIdentifier
  status      String
  region      String
  isWatching  Boolean  @default(false)
  accountId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, region, accountId])
  @@index([accountId])
  @@schema("module/aws-cloudwatch")
}

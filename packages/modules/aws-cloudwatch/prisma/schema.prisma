// CloudWatch data collection resolves the cross-account binding provided by
// aws-identity (AwsCrossAccountBinding) for the account it addresses at
// runtime; the region scope lives on the binding as well. Instances are scoped
// directly by accountId (plain column, no foreign key — the AWS account is the
// resource's real host and the binding row is identity, not ownership).
model Ec2Instance {
  id          String   @id @default(uuid()) @db.Uuid
  instanceId  String
  name        String
  status      String?
  region      String
  isWatching  Boolean  @default(false)
  accountId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([instanceId, accountId])
  @@index([accountId])
  @@schema("module/aws-cloudwatch")
}

model RdsInstance {
  id          String   @id @default(uuid()) @db.Uuid
  instanceId  String   @unique // DbiResourceId
  name        String // DBInstanceIdentifier
  status      String
  region      String
  isWatching  Boolean  @default(false)
  accountId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, region, accountId])
  @@index([accountId])
  @@schema("module/aws-cloudwatch")
}

// !! ------------------------------------------------------------ //
// !!            [Module] AWS CloudWatch models              //
// !! ------------------------------------------------------------ //
// * AwsAccount                                                    //
// * Ec2Instance                                                   //
// * RdsInstance                                                   //
// * ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ //

// AWS access keys are no longer stored on this model. CloudWatch data
// collection resolves the project-shared cross-account binding provided by
// aws-identity (AwsCrossAccountBinding) at runtime. AwsAccount only keeps
// the monitoring scope: the 12-digit AWS account id anchor and the regions
// to discover.
model AwsAccount {
  id           String         @id @default(uuid()) @db.Uuid
  awsAccountId String         @unique
  regions      AwsRegion[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  ec2Instances Ec2Instance[]
  rdsInstances RdsInstance[]

  @@schema("module/aws-cloudwatch")
}

model Ec2Instance {
  id           String     @id @default(uuid()) @db.Uuid
  instanceId   String     @unique
  name         String
  status       String?
  region       AwsRegion
  isWatching   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  awsAccount   AwsAccount @relation(fields: [awsAccountId], references: [id])
  awsAccountId String     @db.Uuid

  @@schema("module/aws-cloudwatch")
}

model RdsInstance {
  id           String     @id @default(uuid()) @db.Uuid
  instanceId   String     @unique // DbiResourceId
  name         String // DBInstanceIdentifier
  status       String
  region       AwsRegion
  isWatching   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  awsAccount   AwsAccount @relation(fields: [awsAccountId], references: [id])
  awsAccountId String     @db.Uuid

  @@unique([name, region, awsAccountId])
  @@schema("module/aws-cloudwatch")
}

enum AwsRegion {
  us_east_1
  us_east_2
  cn_north_1
  cn_northwest_1

  @@schema("module/aws-cloudwatch")
}

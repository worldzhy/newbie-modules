// * TaskDependency                                                //
// * TaskStatus / ActorKind (enums)                                //
// !! ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

/// One actor in the task system. A HUMAN actor stands for a host account user;
/// a CREWMATE actor stands for a crewmate (a worker, not an account). The host
/// adds the opaque `userId` / `crewmateId` scalars (and their unique indexes) in
/// its own schema; this module stores only the fields shared by every host.
/// Exactly one of the two identifiers is set, enforced by the service because
/// Prisma cannot express a one-of constraint.
model TaskActor {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind        ActorKind
  displayName String?
  avatarUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdTasks      Task[] @relation("TaskCreator")
  assignedTasks     Task[] @relation("TaskAssignee")
  lastOperatedTasks Task[] @relation("TaskLastOperator")

  @@index([kind])
  @@schema("module/task-management")
}

/// One task (work item) in a project: title, description, status, creator and
/// assignee actors, delivery plan, and prerequisite edges. Deletion is soft
/// through `deletedAt`. `projectId` is the host project the task belongs to;
/// the host adds the Project relation on top of this scalar.
model Task {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  /// Host project that owns the task; no foreign key in this module.
  projectId String @db.Uuid

  /// Parent task in the design/execution hierarchy. A task with a parent is a
  /// design unit: it aggregates children and is never dispatched on its own.
  parentId String? @db.Uuid
  parent   Task?   @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Task[]  @relation("TaskHierarchy")

  /// Delivery-plan fields shared by every host that runs the delivery pipeline:
  /// design source reference, derived design-review flag, acceptance criteria,
  /// allowed path globs, declared change impact, origin discussion reference,
  /// and the gate diagnostics captured when a task blocks.
  designReference                String?
  designReviewRequired           Boolean    @default(false)
  acceptanceCriteria             String?
  allowedPaths                   String[]   @default([])
  changeImpact                   Json?
  originReference                Json?
  blockedReason                  String?
  designReferenceJustification   String?
  requirementReview              Json?

  /// Set the first time the task starts (PENDING/BLOCKED -> DEVELOPING).
  /// `changeImpact`, `allowedPaths` and the derived `designReviewRequired`
  /// freeze from then on and are only editable through the human override
  /// channel (ADR-054 D3).
  planFrozenAt DateTime?

  /// Refreshed by the runtime while it works on the task. The reaper parks
  /// DEVELOPING tasks whose heartbeat stopped, so a dead crewmate cannot leave
  /// a task running forever.
  heartbeatAt DateTime?

  creatorId  String?    @db.Uuid
  creator    TaskActor? @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  assigneeId String?    @db.Uuid
  assignee   TaskActor? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  lastOperatorId String?    @db.Uuid
  lastOperator   TaskActor? @relation("TaskLastOperator", fields: [lastOperatorId], references: [id], onDelete: SetNull)

  /// Prerequisite edges where this task is the dependent. The join rows are the
  /// single source of truth; there is no scalar id array to keep in sync.
  dependencies TaskDependency[] @relation("TaskDependencies")
  dependents   TaskDependency[] @relation("TaskDependents")

  @@index([parentId])
  @@index([projectId, status])
  @@index([status, heartbeatAt])
  @@schema("module/task-management")
}

/// Prerequisite edge between two tasks: `taskId` may not start until
/// `prerequisiteTaskId` reaches COMPLETED. The composite primary key makes an
/// edge unique; a self-edge is rejected by the service.
model TaskDependency {
  taskId             String   @db.Uuid
  prerequisiteTaskId String   @db.Uuid
  createdAt          DateTime @default(now())

  task         Task @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  prerequisite Task @relation("TaskDependents", fields: [prerequisiteTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, prerequisiteTaskId])
  @@index([prerequisiteTaskId])
  @@schema("module/task-management")
}

/// Task lifecycle. Status updates follow the service's fixed transition table:
/// PENDING to DEVELOPING, BLOCKED or CANCELLED; BLOCKED to DEVELOPING or
/// CANCELLED; DEVELOPING to TESTING, BLOCKED or CANCELLED; TESTING to DEVELOPING,
/// MERGED, BLOCKED or CANCELLED; MERGED to DEVELOPING, DEPLOYED, BLOCKED or
/// CANCELLED; DEPLOYED to DEVELOPING, BLOCKED, COMPLETED or CANCELLED.
/// COMPLETED and CANCELLED are terminal. CANCELLED is a status, distinct from
/// the soft delete in `deletedAt`; BLOCKED means a gate stopped the task and a
/// human must clear it.
enum TaskStatus {
  PENDING
  BLOCKED
  DEVELOPING
  TESTING
  MERGED
  DEPLOYED
  COMPLETED
  CANCELLED

  @@schema("module/task-management")
}

/// Who an actor row stands for: a host account user or a crewmate. Crewmates
/// are workers, not accounts (ADR-003 D2).
enum ActorKind {
  HUMAN
  CREWMATE

  @@schema("module/task-management")
}

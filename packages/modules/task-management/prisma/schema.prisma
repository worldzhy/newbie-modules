// !! ------------------------------------------------------------ //
// !!            [Module] Task Management models             //
// !! ------------------------------------------------------------ //
// * TaskSpace (1:1 companion space for a Nightwatch Project)       //
// * Task (Work Item)                                              //
// * TaskParticipant (Actor referenced by an external identity)    //
// * ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ //

model TaskSpace {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String  @unique @db.Uuid // 1:1 link to the Nightwatch Project
  name        String? // Space name; the caller passes the project name at creation
  description String? // Space description

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]

  @@schema("module/task-management")
}

model TaskParticipant {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Opaque, host-defined identity source (e.g. the host account system or an IM platform).
  identitySource String
  // Participant ID within that source. Opaque string: host IDs are not assumed to be UUIDs.
  externalId     String
  name           String? // Participant display name snapshot
  avatarUrl      String? // Participant avatar URL snapshot
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdTasks   Task[]   @relation("CreatedTasks") // Tasks created by this participant
  assignedTasks  Task[]   @relation("AssignedTasks") // Tasks assigned to this participant

  @@unique([identitySource, externalId])
  @@schema("module/task-management")
}

model Task {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String // Task title
  description String? // Task details
  status      TaskStatus @default(PENDING) // Current workflow status
  dueDate     DateTime? // Expected completion time
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime? // Soft delete timestamp

  spaceId String    @db.Uuid
  space   TaskSpace @relation(fields: [spaceId], references: [id])

  // Direct link to the Nightwatch Project (flattened; no TaskProject indirection).
  projectId String @db.Uuid

  creatorId String?          @db.Uuid
  creator   TaskParticipant? @relation("CreatedTasks", fields: [creatorId], references: [id])

  assigneeId String?          @db.Uuid
  assignee   TaskParticipant? @relation("AssignedTasks", fields: [assigneeId], references: [id])

  // Last Operation Tracking
  lastOperatorId     String? // User ID or External ID of the last modifier
  lastOperatorName   String? // Display Name of the last modifier
  lastOperatorSource String? // "LARK" | "SYSTEM" | "WEB"

  @@schema("module/task-management")
}

enum TaskStatus {
  PENDING
  DEVELOPING
  TESTING
  DEPLOYED
  COMPLETED
  CANCELLED

  @@schema("module/task-management")
}

/// One task space per host project: a 1:1 companion container for that
/// project's tasks, enforced by the unique `projectId`. The host adds the
/// project relation; the space name is optional and caller-supplied.
model TaskSpace {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String   @unique @db.Uuid
  name        String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]

  @@schema("module/task-management")
}

/// One actor in the task system, identified by the host user it stands for.
/// `name` and `avatarUrl` copy that user's display fields, captured when the
/// participant row is created.
model TaskParticipant {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String?
  avatarUrl         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdTasks      Task[]   @relation("CreatedTasks")
  assignedTasks     Task[]   @relation("AssignedTasks")
  lastOperatorTasks Task[]   @relation("LastOperatorTasks")

  @@schema("module/task-management")
}

/// One task (work item) in a space: title, description, status, optional due
/// date, and creator/assignee participants. Status updates follow the service's
/// transition table; deletion is soft through `deletedAt`. The last-operator
/// fields record who most recently changed the task.
model Task {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String?
  status      TaskStatus        @default(PENDING)
  dueDate     DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  /// Parent task in the design/execution hierarchy. A task with a parent is a
  /// design unit: it aggregates children and is never dispatched on its own.
  parentId String? @db.Uuid
  parent   Task?   @relation("TaskHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Task[]  @relation("TaskHierarchy")

  /// Delivery-plan fields shared by every host that runs the delivery pipeline:
  /// design source reference, acceptance criteria, allowed path globs, declared
  /// impact, prerequisite task ids, origin discussion reference, and the gate
  /// diagnostics captured when a task blocks.
  designRef              String?
  acceptanceCriteria     String?
  scopePaths             String[]         @default([])
  impact                 Json?
  changeClass            TaskChangeClass?
  dependsOn              String[]         @default([])
  sourceRef              Json?
  blockedReason          String?
  designRefJustification String?
  requirementReview      Json?
  /// Set the first time the task starts (PENDING/BLOCKED -> DEVELOPING).
  /// `impact`, `scopePaths` and the derived `changeClass` freeze from then on
  /// and are only editable through the human override channel (ADR-054 D3).
  planFrozenAt DateTime?

  spaceId   String    @db.Uuid
  space     TaskSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  creatorId  String?         @db.Uuid
  creator    TaskParticipant? @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: SetNull)

  assigneeId String?         @db.Uuid
  assignee   TaskParticipant? @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)

  lastOperatorParticipantId String? @db.Uuid
  lastOperatorParticipant   TaskParticipant? @relation("LastOperatorTasks", fields: [lastOperatorParticipantId], references: [id], onDelete: SetNull)
  lastOperatorName          String?

  @@index([parentId])
  @@schema("module/task-management")
}

/// Task lifecycle. Status updates follow the service's fixed transition table:
/// PENDING to DEVELOPING, BLOCKED or CANCELLED; DEVELOPING to TESTING, BLOCKED or
/// CANCELLED; TESTING to DEVELOPING, DEPLOYED, COMPLETED or CANCELLED; DEPLOYED to
/// DEVELOPING, COMPLETED or CANCELLED; BLOCKED to DEVELOPING or CANCELLED.
/// COMPLETED and CANCELLED are terminal. CANCELLED is a status, distinct from
/// the soft delete in `deletedAt`; BLOCKED means a gate stopped the task and a
/// human must clear it.
enum TaskStatus {
  PENDING
  DEVELOPING
  TESTING
  DEPLOYED
  COMPLETED
  CANCELLED
  BLOCKED

  @@schema("module/task-management")
}

/// Delivery-plan class, derived from `impact` and `scopePaths` rather than
/// declared by hand: DESIGNED when the task spans several repositories, touches
/// the schema or a contract, is irreversible, or declares more than 20 allowed
/// path globs; SIMPLE otherwise.
enum TaskChangeClass {
  SIMPLE
  DESIGNED

  @@schema("module/task-management")
}

// ! ------------------------------------------------------------ //
// !             [Module] Shortcut models                    //
// ! ------------------------------------------------------------ //
// * ShortcutGroup                                                  //
// * ShortcutItem                                                  //
// * ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

model ShortcutGroup {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  sort        Int            @default(0)
  parentId    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       ShortcutItem[]

  @@schema("module/shortcut")
}

model ShortcutItem {
  id          Int              @id @default(autoincrement())
  label       String
  content     String
  description String?
  type        ShortcutItemType
  sort        Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  group       ShortcutGroup    @relation(fields: [groupId], references: [id])
  groupId     Int

  @@schema("module/shortcut")
}

enum ShortcutItemType {
  LINK
  TEXT

  @@schema("module/shortcut")
}

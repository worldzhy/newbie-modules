// !! ------------------------------------------------------------ //
// !!                 [Module] Alert Center models                 //
// !! ------------------------------------------------------------ //
// * Alert                                                         //
// * AlertSource                                                   //
// !! ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

// One alert lifecycle (ADR-065): a firing event opens it, repeated reports
// advance `lastSeenAt`/`occurrences` without resetting the reminder cadence,
// and a resolve closes it. No delivery verdict lives here; delivery policy
// belongs to the notification domain, which this module only calls.
model Alert {
  id        String  @id @default(uuid()) @db.Uuid
  // Joined scopeId:source:alertKey; a value beyond the column width is hashed
  // rather than rejected. Unique, so the database arbitrates concurrent first
  // reports.
  fingerprint String @unique @db.VarChar(255)
  // Producer key declared in the code-side source registry.
  source      String  @db.VarChar(100)
  // Opaque scope (project / tenant / platform) owned by the host.
  scopeId     String? @db.VarChar(100)
  // Severity of the current lifecycle, unchanged when it resolves so both
  // messages follow the same delivery rules.
  severity    String  @db.VarChar(20)
  // Routing and display labels for the notification domain; never used to
  // filter the alert list, which reads first-class columns only.
  labels      Json
  // Opaque rendering context (url, error text, counts); not interpreted here.
  data        Json?

  // firing | resolved.
  state       String  @db.VarChar(20) @default("firing")
  // Reminder cadence of this lifecycle, in minutes.
  repeatIntervalMinutes Int  @default(1440)
  // Next due external reminder; null once resolved.
  nextNotificationAt   DateTime?
  // Last external reminder actually sent.
  lastNotificationAt   DateTime?
  // Reminders sent in this lifecycle; 0 means only the initial firing message
  // went out. Reminders reuse the firing template and change only the rendered
  // title, so the counter stays out of the template `notificationKey` but is
  // part of the record-level deduplication key (ADR-065 §4).
  reminderCount        Int    @default(0)

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @updatedAt
  resolvedAt  DateTime?
  occurrences Int       @default(1)
  createdAt   DateTime  @default(now())

  @@index([state, nextNotificationAt])
  @@index([scopeId, source])
  @@schema("module/alert-center")
}

// Operator overrides for a code-registered source (key / displayName /
// defaultRepeatMinutes). Only sources an operator changed get a row, so a typo
// can never invent a source and a default never lives in two places.
model AlertSource {
  // Key declared in the code-side source registry.
  key                     String    @id @db.VarChar(100)
  // Overrides the registered cadence; null inherits it.
  repeatMinutes           Int?
  // External delivery pauses until this moment and then expires on its own.
  // Recording and resolving keep working while paused.
  notificationPausedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("module/alert-center")
}

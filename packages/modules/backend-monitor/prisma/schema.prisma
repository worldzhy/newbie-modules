// * BackendMonitorInstallation                                    //
// !! ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄ ⌄  //

// One row per deployment endpoint that reports backend request metrics and
// error logs, identified by its report token. The token is a random UUID; only
// its SHA-256 hash is stored, the plaintext is returned once at enrollment or
// rotation, and revocation is a soft delete.
//
// Host-side grouping stays in opaque `externalRef` (convention:
// "projectId/applicationId"). A host-bound resolver maps it to the
// applicationId stamped on ClickHouse rows.
//
// Liveness is derived from `lastSeenAt`, not stored: never seen (null), online,
// or stale after three minutes without a batch. Only revocation is persisted
// explicitly.
model BackendMonitorInstallation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Human-readable label set at enrollment, e.g. "nightwatch-prod".
  label String @db.VarChar(255)
  // SHA-256 hex of the report token. The plaintext token is returned once at
  // creation or rotation and never stored.
  tokenHash String @unique @db.VarChar(64)

  // Opaque platform-owned tag (convention: "projectId/applicationId"); the ingest
  // resolver maps it to the applicationId used on ClickHouse rows.
  externalRef String? @db.VarChar(255)

  // Runtime facts refreshed from ingest batches; informational only.
  // Deployment environment, e.g. "prod".
  env String? @db.VarChar(64)
  // Deployed application version, e.g. a git sha or semver.
  appVersion String? @db.VarChar(64)
  // Reporting instance identifier, e.g. an EC2 instance id or a hostname.
  instanceId String? @db.VarChar(128)
  // Reporter family, e.g. "newbie"; informational.
  kind String? @db.VarChar(32)

  firstSeenAt DateTime?
  lastSeenAt  DateTime?

  // Soft revocation: ingest is rejected (401); rows are retained for history.
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("module/backend-monitor")
}

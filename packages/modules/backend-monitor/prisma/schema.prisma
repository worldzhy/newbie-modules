// Self-reported facts of a backend-monitor installation, which reports backend
// request metrics and error logs. Identity and credential live in the shared
// `Installation` row (module/security, ADR-078); this table is 1:1 with it and
// keeps only what an ingest batch carries.
//
// Host-side grouping stays in the shared row's opaque `externalRef`
// (convention: "projectId/applicationId"). A host-bound resolver maps it to the
// applicationId stamped on ClickHouse rows.
//
// Liveness (never seen / online / stale after three minutes without a batch) is
// derived at read time from the shared row's `lastSeenAt`.
//
// `installationId` is a plain scalar, not a relation: Prisma relations cannot
// cross schema boundaries in this repository, and the shared table must not
// depend on optional collector modules. 1:1 is guaranteed by the write path.
model BackendMonitorAgentState {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  installationId String @unique @db.Uuid

  // Runtime facts refreshed from ingest batches; informational only.
  // Deployment environment, e.g. "prod".
  env String? @db.VarChar(64)
  // Deployed application version, e.g. a git sha or semver.
  appVersion String? @db.VarChar(64)
  // Reporting instance identifier, e.g. an EC2 instance id or a hostname.
  instanceId String? @db.VarChar(128)
  // Runtime/reporter family, e.g. "newbie". Named `runtime` so it is not
  // confused with the installation-level `kind` on the shared row.
  runtime String? @db.VarChar(32)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("module/backend-monitor")
}

{
  "key": "local-storage",
  "layer": "infrastructure",
  "wiring": {
    "file": "local-storage.module",
    "className": "LocalStorageModule",
    "prismaSchema": "prisma/schema.prisma"
  },
  "requires": {
    "config": {
      "storage": {
        "local": {
          "path": "process.env.STORAGE_LOCAL_PATH"
        }
      }
    },
    "env": {
      "STORAGE_LOCAL_PATH": ""
    },
    "dependencies": {
      "multer": "latest"
    },
    "devDependencies": {
      "@types/multer": "latest"
    }
  }
}

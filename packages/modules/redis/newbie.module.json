{
  "key": "redis",
  "layer": "datastore",
  "wiring": {
    "file": "redis.module",
    "className": "RedisModule"
  },
  "requires": {
    "config": {
      "redis": {
        "host": "process.env.REDIS_HOST",
        "password": "process.env.REDIS_PASSWORD"
      }
    },
    "env": {
      "REDIS_HOST": "",
      "REDIS_PASSWORD": ""
    }
  },
  "dependencies": {
    "ioredis": "latest"
  }
}

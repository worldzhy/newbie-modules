{
  "key": "slack",
  "layer": "infrastructure",
  "module": {
    "file": "slack.module",
    "className": "SlackModule"
  },
  "config-service": {
    "slack": {
      "token": "process.env.SLACK_TOKEN",
      "slackApiUrl": "process.env.SLACK_API_URL"
    }
  },
  "env": {
    "SLACK_TOKEN": "",
    "SLACK_API_URL": ""
  },
  "dependencies": {
    "@slack/web-api": "latest",
    "p-queue": "^6.6.2",
    "p-retry": "^4.6.2"
  }
}

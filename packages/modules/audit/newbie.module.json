{
  "key": "audit",
  "layer": "foundation",
  "module": {
    "file": "audit.module",
    "className": "AuditModule"
  },
  "schema": "prisma/schema.prisma",
  "moduleDependencies": ["security"],
  "config-service": {
    "audit": {
      "geolocationLruSize": "int(process.env.AUDIT_GEOLOCATION_LRU_SIZE, 100)"
    }
  },
  "env": {
    "AUDIT_GEOLOCATION_LRU_SIZE": ""
  },
  "dependencies": {
    "geolite2-redist": "latest",
    "lru-cache": "latest",
    "maxmind": "latest",
    "ua-parser-js": "latest"
  },
  "devDependencies": {}
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": [],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@modules/*": ["./packages/modules/*"]
    }
  },
  "include": ["packages/**/*.ts"],
  "exclude": ["node_modules"]
}

{
  "name": "newbie-modules",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo registry of newbie backend modules consumed by @devbie/newbie-cli",
  "prettier": "@devbie/style-guide/prettier",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import": "node scripts/import-modules.mjs",
    "lint": "eslint \"packages/**/*.ts\"",
    "lint:fix": "eslint \"packages/**/*.ts\" --fix",
    "test:frontend-monitor": "node --import tsx --test packages/modules/frontend-monitor/modules/jobs/alert-lifecycle.test.ts packages/modules/frontend-monitor/modules/jobs/error-source.test.ts",
    "prepare": "command -v git >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@devbie/style-guide": "^1.5.0",
    "eslint": "^9.39.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15"
  }
}

{
  "name": "newbie-modules",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo registry of newbie backend modules consumed by @devbie/newbie-cli",
  "prettier": "@devbie/style-guide/prettier",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "import": "node scripts/import-modules.mjs",
    "lint": "eslint \"packages/**/*.ts\"",
    "lint:fix": "eslint \"packages/**/*.ts\" --fix"
  },
  "devDependencies": {
    "@devbie/style-guide": "^1.3.1",
    "eslint": "^9.39.4",
    "prettier": "^3.9.9"
  }
}
